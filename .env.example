# MANZAR Backend — Environment Variables
# Copy this to .env and fill in your values

# --- Frontend URL (used in QR codes) ---
FRONTEND_URL=http://localhost:8000

# --- Server ---
PORT=8000

# --- Compute backend for 3D reconstruction ---
# Options: local, kaggle, colab, ecs
COMPUTE_BACKEND=local

# --- COLMAP / OpenMVS binary paths ---
COLMAP_BIN=/path/to/colmap-wrapper.sh
OPENMVS_BIN=/usr/local/bin

# --- Stage timeout (seconds) for each pipeline stage ---
STAGE_TIMEOUT=300

# --- Reconstruction working directory ---
RECON_WORK_DIR=reconstruction

# --- ngrok tunnel (set USE_TUNNEL=true for live demo) ---
USE_TUNNEL=false
NGROK_AUTH_TOKEN=

# --- Vision LLM for Ask MANZAR chatbot ---
# Options: stub, qwen, gemini
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash

# --- OpenRouter (Alternative provider with free Qwen models) ---
# Get free API key from: https://openrouter.ai/keys
# Free models: qwen/qwen3-vl-8b-instruct, qwen/qwen3.8-flash
VISION_PROVIDER=gemini
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct
