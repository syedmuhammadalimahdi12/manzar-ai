<section class="screen" data-screen="empty-states">
  <div class="container" style="padding-top:32px; padding-bottom:56px;">
    <h1 style="font-size:24px; margin-bottom:6px;">UX States</h1>
    <p class="text-2 mb-20">How MANZAR communicates gaps and failures — never silent, always specific.</p>
    <div class="flex gap-8 mb-28">
      <button class="btn state-tab is-active" data-esd="a">No Evidence Yet</button>
      <button class="btn state-tab" data-esd="b">Camera Disconnected</button>
      <button class="btn state-tab" data-esd="c">Incomplete Reconstruction</button>
    </div>
    <div data-panel="a" class="panel-active">
      <div class="card card-pad-lg text-center" style="max-width:640px; margin:0 auto;">
        <div style="font-size:52px; margin-bottom:16px;">📭</div>
        <h2 style="font-size:20px; margin-bottom:10px;">No Evidence Captured Yet</h2>
        <p class="text-2 mb-24" style="line-height:1.7;">This session was created but no participant has captured a photo yet. Share the QR code to begin collecting evidence.</p>
        <div class="flex justify-center gap-10"><a class="btn btn-primary" data-goto="qr-join">Show QR Code</a><a class="btn" data-goto="create-session">Edit Session</a></div>
      </div>
    </div>
    <div data-panel="b">
      <div class="card card-pad-lg text-center" style="max-width:640px; margin:0 auto; border-color:var(--warning-border);">
        <div style="font-size:52px; margin-bottom:16px;">📵</div>
        <h2 style="font-size:20px; margin-bottom:10px;">Camera Disconnected Mid-Session</h2>
        <p class="text-2 mb-16" style="line-height:1.7;">A participant's device lost connection after uploading some expected images. Reconstruction can proceed with data already received (NFR-6 — graceful failure).</p>
        <div class="alert alert-warning mb-20" style="text-align:left;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><p>Losing a camera may leave an angle uncovered. Coverage check will re-evaluate once you continue.</p></div>
        <div class="flex justify-center gap-10"><a class="btn btn-primary" data-goto="evidence-upload">Go to Evidence Upload</a><a class="btn" data-goto="qr-join">Wait for Reconnect</a></div>
      </div>
    </div>
    <div data-panel="c">
      <div class="card card-pad-lg text-center" style="max-width:640px; margin:0 auto; border-color:var(--purple-border);">
        <div style="font-size:52px; margin-bottom:16px;">🧩</div>
        <h2 style="font-size:20px; margin-bottom:10px;">Reconstruction Incomplete</h2>
        <p class="text-2 mb-16" style="line-height:1.7;">Only 1 of 4 recommended angles was captured before the session timed out. A full 3D reconstruction isn't reliable from a single angle — MANZAR will not fabricate a confident result.</p>
        <div class="flex justify-center gap-8 mb-20 wrap"><span class="tag tag-green">Front — captured</span><span class="tag tag-gray">Left — missing</span><span class="tag tag-gray">Right — missing</span><span class="tag tag-gray">Back — missing</span></div>
        <div class="flex justify-center gap-10"><a class="btn btn-primary" data-goto="qr-join">Request More Captures</a></div>
      </div>
    </div>
  </div>
</section>

</main>

<!-- ============================================================= -->
<!-- QUICK NAV -->
<!-- ============================================================= -->
<div class="quick-nav" id="quick-nav">
  <button class="quick-nav-btn" id="quick-nav-toggle" aria-label="Browse all screens">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
  </button>
  <div class="quick-nav-panel" id="quick-nav-panel"></div>
</div>

<script>
/* =================================================================
   MANZAR — Live Frontend (wired to backend API)
   ================================================================= */

// ─── Configuration ────────────────────────────────────────────────
// API is on same origin as frontend (both served from backend)
const API_BASE = location.origin;

const WS_BASE = API_BASE.replace(/^http/, 'ws');
const POLL_INTERVAL = 3000;      // session state poll (ms)
const RECONNECT_DELAY = 3000;    // WebSocket reconnect delay (ms)

// ─── Global State ─────────────────────────────────────────────────
const APP = {
  sessionId: null,
  session: null,
  ws: null,
  wsReconnectTimer: null,
  pollTimer: null,
  chatMessages: [],
  deviceId: 'device-' + Math.random().toString(36).slice(2, 8),
  isConnected: false,
};

// ─── Screen Navigation (preserved from original) ─────────────────
const SCREENS = [
  { group:'Public', items:[ ['landing','Landing Page'], ['session-history','Session History'] ] },
  { group:'Capture Workflow', items:[ ['create-session','Create Session'], ['capture-choice','Capture Choice'], ['qr-join','QR Join'], ['direct-upload','Direct Upload'], ['evidence-upload','Evidence Upload'] ] },
  { group:'Mobile', items:[ ['mobile-join','Mobile Join'], ['mobile-thanks','Thank You'], ['mobile-camera','Camera Capture'] ] },
  { group:'Analysis', items:[ ['dashboard','Investigation Dashboard'], ['cross-angle','Cross-Angle Verification'], ['ask-manzar','Ask MANZAR'], ['report','Incident Report'], ['evidence-detail','Evidence Detail'] ] },
  { group:'UX States', items:[ ['empty-states','Empty / Error States'] ] },
];
const NO_TOPBAR = ['mobile-join','mobile-thanks','mobile-camera','evidence-detail'];

function renderQuickNav(current){
  const panel = document.getElementById('quick-nav-panel');
  let html = '';
  SCREENS.forEach(g=>{
    html += `<div class="quick-nav-group">${g.group}</div>`;
    g.items.forEach(([id,label])=>{
      const cur = id===current ? ' current' : '';
      html += `<div class="quick-nav-item${cur}" data-goto="${id}">${id===current?'› ':''}${label}</div>`;
    });
  });
  panel.innerHTML = html;
}

const loader = document.getElementById('top-loader');

function goto(id){
  const target = document.querySelector(`.screen[data-screen="${id}"]`);
  if (!target) return;
  const current = document.querySelector('.screen.active');
  if (current === target) { window.scrollTo({top:0, behavior:'smooth'}); return; }

  loader.classList.add('loading');

  setTimeout(()=>{
    if (current) current.classList.remove('active');
    target.classList.add('active');
    document.body.setAttribute('data-screen', id);
    document.body.classList.toggle('no-topbar', NO_TOPBAR.includes(id));
    window.scrollTo({top:0, behavior:'instant' in window.scrollTo ? undefined : 'auto'});
    window.scrollTo(0,0);
    renderQuickNav(id);
    history.pushState({screen: id},'', '#'+id);
    target.style.animation = 'none';
    void target.offsetWidth;
    target.style.animation = '';
    // Trigger screen-specific init
    onScreenEnter(id);
  }, 180);

  setTimeout(()=>{ loader.classList.remove('loading'); }, 460);
}

document.addEventListener('click', (e)=>{
  const el = e.target.closest('[data-goto]');
  if (el){ e.preventDefault(); goto(el.getAttribute('data-goto')); }
});

// ── Browser Back button — navigate between app screens ──
window.addEventListener('popstate', function(e){
  if (e.state && e.state.screen){
    const target = document.querySelector(`.screen[data-screen="${e.state.screen}"]`);
    if (target){
      const current = document.querySelector('.screen.active');
      if (current) current.classList.remove('active');
      target.classList.add('active');
      document.body.setAttribute('data-screen', e.state.screen);
      document.body.classList.toggle('no-topbar', NO_TOPBAR.includes(e.state.screen));
      window.scrollTo(0,0);
      renderQuickNav(e.state.screen);
      onScreenEnter(e.state.screen);
    }
  } else {
    // Fallback: always go to landing page on reload (ignore hash)
    const target = document.querySelector(`.screen[data-screen="landing"]`);
    if (target){
      const current = document.querySelector('.screen.active');
      if (current) current.classList.remove('active');
      target.classList.add('active');
      document.body.setAttribute('data-screen', 'landing');
      window.scrollTo(0,0);
      onScreenEnter('landing');
    }
  }
});

document.getElementById('quick-nav-toggle').addEventListener('click', (e)=>{
  e.stopPropagation();
  document.getElementById('quick-nav').classList.toggle('open');
});
document.addEventListener('click', (e)=>{
  const nav = document.getElementById('quick-nav');
  if (!nav.contains(e.target)) nav.classList.remove('open');
});

// Empty-states local tab switcher
document.querySelectorAll('[data-esd]').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('[data-esd]').forEach(b=>b.classList.remove('is-active'));
    btn.classList.add('is-active');
    document.querySelectorAll('[data-panel]').forEach(p=>p.classList.remove('panel-active'));
    document.querySelector(`[data-panel="${btn.getAttribute('data-esd')}"]`).classList.add('panel-active');
  });
});

// ─── Toast Notifications ──────────────────────────────────────────
function toast(message, type='info', duration=4000){
  // Toasts disabled globally until reconnect storm is fixed
  return;
}

// ─── Connection Status Bar ────────────────────────────────────────
function setConnectionStatus(status){
  const bar = document.getElementById('connection-bar');
  bar.className = status; // 'connected', 'disconnected', 'connecting'
  const labels = { connected:'WS Connected', disconnected:'Disconnected — reconnecting...', connecting:'Connecting...' };
  bar.textContent = labels[status] || status;
  if (status === 'connected'){
    setTimeout(()=>{ bar.style.transform = 'translateY(-100%)'; bar.className = ''; }, 2500);
    bar.style.transform = '';
  } else {
    bar.style.transform = '';
  }
}

// ─── API Helpers ──────────────────────────────────────────────────
async function api(path, options={}){
  const url = API_BASE + path;
  try {
    const res = await fetch(url, {
      headers: { 'Content-Type': 'application/json', ...options.headers },
      ...options,
    });
    if (!res.ok){
      const err = await res.json().catch(()=>({ error: res.statusText }));
      throw new Error(err.error || err.detail || `HTTP ${res.status}`);
    }
    return await res.json();
  } catch(err){
    if (err.name === 'TypeError' && err.message.includes('fetch')){
      toast('Cannot reach backend server. Is it running?', 'error');
    }
    throw err;
  }
}

async function apiBlob(path){
  const url = API_BASE + path;
  const res = await fetch(url);
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return await res.blob();
}

function setBtnLoading(btn, loading){
  if (loading){
    btn.classList.add('is-loading');
    btn.dataset.origText = btn.innerHTML;
    btn.innerHTML = `<span class="spinner spinner-white"></span> Working...`;
  } else {
    btn.classList.remove('is-loading');
    if (btn.dataset.origText) btn.innerHTML = btn.dataset.origText;
  }
}

// ─── WebSocket Manager ───────────────────────────────────────────
function wsConnect(sessionId){
  if (APP.ws && APP.ws.readyState <= 1) return; // already open/connecting
  const url = `${WS_BASE}/ws/${sessionId}`;
  setConnectionStatus('connecting');

  try {
    const ws = new WebSocket(url);

    ws.onopen = ()=>{
      APP.isConnected = true;
      setConnectionStatus('connected');
      toast('Connected to live session', 'success', 2500);
    };

    ws.onmessage = (evt)=>{
      try {
        const msg = JSON.parse(evt.data);
        handleWsEvent(msg);
      } catch(e){ /* ignore non-JSON */ }
    };

    ws.onclose = async ()=>{
      APP.isConnected = false;
      if (APP.ws === ws) APP.ws = null;
      setConnectionStatus('disconnected');
      if (!APP.sessionId) return;

      // Do not retry forever when the in-memory development session is gone.
      try {
        const check = await fetch(`${API_BASE}/session/${APP.sessionId}`);
        if (check.status === 404) {
          sessionStorage.removeItem('manzar_session_id');
          APP.sessionId = null;
          APP.session = null;
          stopPolling();
          return;
        }
      } catch (_) {
        // Network failures are transient; keep the normal reconnect behavior.
      }

      APP.wsReconnectTimer = setTimeout(()=>{
        if (APP.sessionId) wsConnect(APP.sessionId);
      }, RECONNECT_DELAY);
    };

    ws.onerror = ()=>{ ws.close(); };
    APP.ws = ws;
  } catch(e){
    setConnectionStatus('disconnected');
  }
}

function wsDisconnect(){
  clearTimeout(APP.wsReconnectTimer);
  if (APP.ws){ APP.ws.onclose = null; APP.ws.close(); APP.ws = null; }
  APP.isConnected = false;
}

function wsSend(data){
  if (APP.ws && APP.ws.readyState === WebSocket.OPEN){
    APP.ws.send(JSON.stringify(data));
  }
}

// ─── WebSocket Event Handler ─────────────────────────────────────
function handleWsEvent(msg){
  const type = msg.type || msg.event;
  const d = msg.data || {};
  switch(type){
    case 'device_joined':
      toast(`New device joined: ${d.device_name || d.device_id || 'unknown'}`, 'info', 3000);
      refreshSessionState();
      break;
    case 'photo_uploaded':
      if (d.is_irrelevant){
        toast(`Irrelevant photo from ${d.device_id || 'device'} — ${d.relevance_reason || 'not accident related'}`, 'warning', 5000);
      } else {
        toast(`Photo received from ${d.device_id || 'device'}`, 'info', 2500);
      }
      refreshSessionState();
      // Also update qr-join screen if visible
      if (document.body.getAttribute('data-screen') === 'qr-join'){
        renderQrPhotoList(APP.session);
      }
      break;
    case 'reconstruction_auto_started':
      const statusMsg2 = document.getElementById('reconstruction-status-msg');
      if (statusMsg2) {
        statusMsg2.style.display = 'block';
        statusMsg2.textContent = d.message || 'Reconstruction started automatically...';
      }
      break;
    case 'coverage_updated':
      refreshSessionState();
      if (document.body.getAttribute('data-screen') === 'qr-join'){
        renderQrPhotoList(APP.session);
      }
      break;
    case 'reconstruction_progress':
      updateReconstructionProgress(d);
      break;
    case 'reconstruction_complete':
    case 'reconstruction_done':
      toast('3D Reconstruction complete!', 'success');
      refreshSessionState();
      break;
    case 'reconstruction_failed':
      // The processing screen renders the error inline after the fresh state arrives.
      refreshSessionState();
      break;
    case 'detection_result':
      refreshSessionState();
      break;
    case 'session_state':
    case 'state':
      // Merge partial state — don't replace APP.session (would lose photos, detections, etc.)
      if (d) { APP.session = { ...APP.session, ...d }; renderCurrentScreen(); }
      break;
    case 'chat_response':
      if (d.message) appendChatMessage(d.role || 'ai', d.message);
      break;
    case 'error':
      // Keep all devices in sync if the backend reports an error.
      refreshSessionState();
      break;
    default:
      // Unknown event — just refresh
      refreshSessionState();
  }
}

// ─── Session State Fetching ───────────────────────────────────────
async function refreshSessionState(){
  if (!APP.sessionId) return;
  try {
    APP.session = await api(`/session/${APP.sessionId}`);
    renderCurrentScreen();
  } catch(e){ /* silent */ }
}

function startPolling(){
  stopPolling();
  APP.pollTimer = setInterval(refreshSessionState, POLL_INTERVAL);
}

function stopPolling(){
  if (APP.pollTimer){ clearInterval(APP.pollTimer); APP.pollTimer = null; }
}

function renderCurrentScreen(){
  const id = document.body.getAttribute('data-screen');
  onScreenEnter(id);
}

// ─── Screen Enter Handler ─────────────────────────────────────────
function onScreenEnter(id){
  switch(id){
    case 'capture-choice': renderCaptureChoice(); break;
    case 'qr-join':        renderQrJoin(); break;
    case 'direct-upload':  renderDirectUpload(); break;
    case 'evidence-upload': renderEvidenceUpload(); break;
    case 'ai-processing':  /* hidden screen */ break;
    case 'dashboard':      renderDashboard(); break;
    case 'cross-angle':    renderCrossAngle(); break;
    case 'report':         renderReport(); break;
    case 'session-history': loadSessionHistory(); break;
    case 'ask-manzar':     renderAskManzar(); break;
    case 'mobile-join':    renderMobileJoin(); break;
    case 'mobile-thanks':  break; // Static thank you screen
    case 'evidence-detail': renderEvidenceDetail(); break;
    case 'session-history': break; // handled by initSessionHistory
  }
}

// ─── SCREEN: Evidence Detail ──────────────────────────────────────
function renderEvidenceDetail(){
  if (!APP.session) return;
  const screen = document.querySelector('[data-screen="evidence-detail"]');
  if (!screen) return;
  
  const photos = APP.session.photos || [];
  if (!photos.length) return;
  
  // Find the main image area and populate with first photo that has detections
  const mainImg = screen.querySelector('img');
  const detPhoto = photos.find(p => p.detections && p.detections.length > 0) || photos[0];
  
  if (mainImg && detPhoto) {
    const imgUrl = detPhoto.filename ? `${API_BASE}/uploads/${APP.sessionId}/${detPhoto.filename}` : '';
    if (imgUrl) {
      mainImg.src = imgUrl;
      mainImg.onload = () => drawBBoxes(mainImg, detPhoto.detections || []);
    }
  }
  
  // Update detection list in evidence detail
  const detList = screen.querySelector('.flex-col.gap-8');
  if (detList && detPhoto && detPhoto.detections) {
    const detailColors = {
      'skid_mark': '#ff4d4f',
      'vehicle_damage': '#fa8c16',
      'debris_field': '#722ed1',
      'point_of_impact': '#eb2f96',
    };
    detList.innerHTML = detPhoto.detections.map(d => {
      const conf = Math.round((d.confidence || 0) * 100);
      const cls = (d.class || '').replace('_',' ').replace(/\b\w/g, l => l.toUpperCase());
      const dotColor = detailColors[d.class] || '#1677ff';
      return `<div class="flex items-center justify-between" style="padding:10px 12px; border-radius:8px; background:var(--fill-2);">
        <div class="flex items-center gap-8">
          <span style="width:8px; height:8px; border-radius:50%; background:${dotColor}; display:inline-block;"></span>
          <span class="text-sm">${cls}</span>
        </div>
        <span class="mono conf" style="color:${dotColor};">${conf}%</span>
      </div>`;
    }).join('');
  }
}

// ─── SCREEN: Create Session ───────────────────────────────────────
document.querySelector('[data-screen="create-session"] .btn-primary.btn-block')?.addEventListener('click', async function(e){
  e.preventDefault();
  e.stopPropagation();
  const btn = this;

  // ── Form validation ──
  const sessName = document.getElementById('session-name')?.value.trim() || '';
  const location = document.getElementById('session-location')?.value.trim() || '';
  const officer = document.getElementById('session-officer')?.value.trim() || '';
  const caseNum = document.getElementById('session-ref')?.value.trim() || '';
  const required = [
    { id: 'session-name', label: 'Session Name', val: sessName },
    { id: 'session-location', label: 'Accident Location', val: location },
    { id: 'session-ref', label: 'Incident Reference No.', val: caseNum },
    { id: 'session-officer', label: 'Officer Name', val: officer },
  ];
  const missing = required.filter(f => !f.val);
  if (missing.length > 0){
    // Highlight missing fields
    missing.forEach(f => {
      const el = document.getElementById(f.id);
      if (el){ el.style.borderColor = '#ff4d4f'; el.style.boxShadow = '0 0 0 2px rgba(255,77,79,0.15)'; }
    });
    toast('Please fill in: ' + missing.map(f => f.label).join(', '), 'error', 5000);
    return;
  }
  // Clear highlights on valid fields
  required.forEach(f => {
    const el = document.getElementById(f.id);
    if (el){ el.style.borderColor = ''; el.style.boxShadow = ''; }
  });

  // Auto-clear red highlights as user types
  ['session-name','session-location','session-ref','session-officer'].forEach(id => {
    const el = document.getElementById(id);
    if (el && !el._clearBound){
      el._clearBound = true;
      el.addEventListener('input', () => { el.style.borderColor = ''; el.style.boxShadow = ''; });
    }
  });

  setBtnLoading(btn, true);
  try {
    const params = new URLSearchParams();
    if (location) params.append('location', location);
    if (officer) params.append('officer_name', officer);
    if (caseNum) params.append('case_number', caseNum);
    const qs = params.toString() ? '?' + params.toString() : '';
    const data = await api('/session/create' + qs, { method: 'POST' });
    APP.sessionId = data.session_id;
    sessionStorage.setItem('manzar_session_id', APP.sessionId);
    toast(`Case ${data.case_number || data.session_id} created`, 'success');
    // Connect WebSocket
    wsConnect(APP.sessionId);
    // Fetch full state
    APP.session = await api(`/session/${APP.sessionId}`);
    goto('capture-choice');
  } catch(err){
    toast('Failed to create session: ' + err.message, 'error');
  } finally {
    setBtnLoading(btn, false);
  }
});

