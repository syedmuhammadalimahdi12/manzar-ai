<main id="main">

<!-- ============================================================= -->
<!-- 1. LANDING -->
<!-- ============================================================= -->
<section class="screen active" data-screen="landing">
  <div class="container">
    <div class="text-center" style="padding:60px 0 32px;">
      <span class="tag tag-blue tag-lg mb-16 fade-item"><span class="tag-dot pulse"></span>SRS v5.1 — Coverage-Aware Capture &amp; Ask MANZAR</span>
      <h1 class="fade-item" style="font-size:56px; line-height:1.1; letter-spacing:-0.02em; margin:20px 0 16px; color:#0b1b34; animation-delay:.05s;">
        Reconstruct the Accident.<br/>
        <span style="background:linear-gradient(135deg,#1677ff,#13c2c2); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">From Every Angle.</span>
      </h1>
      <p class="fade-item" style="max-width:640px; margin:0 auto 8px; color:var(--text-2); font-size:17px; line-height:1.7; animation-delay:.1s;">
        MANZAR turns multiple smartphone captures into a cross-verified 3D reconstruction and an evidence-based
        accident report — then lets investigators ask the evidence questions directly.
      </p>
      <p class="mono text-3 fade-item" style="font-size:13px; margin-top:6px; animation-delay:.14s;">See the scene. Verify the evidence. Reconstruct the truth.</p>
      <div class="flex justify-center gap-12 mt-32 wrap fade-item" style="animation-delay:.18s;">
        <a class="btn btn-primary btn-lg" data-goto="create-session">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Create Investigation Session
        </a>
        <a class="btn btn-lg" data-goto="session-history">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          View Sessions
        </a>
      </div>
    </div>

    <div class="card fade-item" style="overflow:hidden; margin-bottom:40px; border-color:var(--primary-border); animation-delay:.22s;">
      <svg viewBox="0 0 800 420" style="width:100%; height:auto; display:block; background:linear-gradient(180deg,#f3f8ff,#ffffff);">
        <rect x="60" y="60" width="680" height="320" rx="14" fill="#ffffff" stroke="#e6f0ff" stroke-width="1.5"/>
        <polygon points="120,380 680,380 590,210 210,210" fill="#eef2f8"/>
        <line x1="400" y1="210" x2="400" y2="380" stroke="#c8d3e0" stroke-width="2.5" stroke-dasharray="20,14"/>
        <path d="M 240 365 Q 285 315 320 278 Q 342 252 360 232" stroke="#faad14" stroke-width="6" fill="none" stroke-dasharray="10,8" stroke-linecap="round" opacity=".85"/>
        <ellipse cx="368" cy="248" rx="42" ry="26" fill="#ff4d4f" opacity=".13"/>
        <circle cx="368" cy="248" r="12" fill="none" stroke="#ff4d4f" stroke-width="2.4" opacity=".8"/>
        <circle cx="368" cy="248" r="4" fill="#ff4d4f"/>
        <g transform="translate(232,220)">
          <polygon points="8,42 100,42 110,24 -2,24" fill="#dbe8ff" stroke="#1677ff" stroke-width="1"/>
          <polygon points="-2,24 110,24 98,8 12,8" fill="#c3d9ff" stroke="#1677ff" stroke-width="1"/>
          <ellipse cx="20" cy="44" rx="10" ry="5" fill="#22314a"/><ellipse cx="88" cy="44" rx="10" ry="5" fill="#22314a"/>
          <path d="M 92,38 L 110,24 L 114,31 L 105,44 L 94,41 Z" fill="#ffece8" stroke="#ff4d4f" stroke-width="1.2"/>
        </g>
        <g transform="translate(392,238)">
          <ellipse cx="8" cy="34" rx="8" ry="4" fill="#22314a"/><ellipse cx="48" cy="34" rx="8" ry="4" fill="#22314a"/>
          <polygon points="6,34 50,34 46,20 10,20" fill="#efe0ff" stroke="#722ed1" stroke-width="1"/>
          <rect x="22" y="10" width="14" height="11" rx="3" fill="#e4ccfc" stroke="#722ed1" stroke-width="0.8"/>
        </g>
        <g font-family="JetBrains Mono">
          <rect x="88" y="290" width="98" height="54" rx="8" fill="#f5f5f5" stroke="#d9d9d9" stroke-width="1.1" stroke-dasharray="4,3"/>
          <circle cx="112" cy="317" r="8" fill="none" stroke="#d9d9d9" stroke-width="1"/>
          <text x="150" y="313" text-anchor="middle" font-size="9" font-weight="700" fill="#bfbfbf">CAM 01</text>
          <text x="150" y="326" text-anchor="middle" font-size="8" fill="#bfbfbf">—</text>
          <rect x="618" y="90" width="98" height="54" rx="8" fill="#f5f5f5" stroke="#d9d9d9" stroke-width="1.1" stroke-dasharray="4,3"/>
          <circle cx="642" cy="117" r="8" fill="none" stroke="#d9d9d9" stroke-width="1"/>
          <text x="680" y="113" text-anchor="middle" font-size="9" font-weight="700" fill="#bfbfbf">CAM 02</text>
          <text x="680" y="126" text-anchor="middle" font-size="8" fill="#bfbfbf">—</text>
          <rect x="88" y="90" width="98" height="54" rx="8" fill="#f5f5f5" stroke="#d9d9d9" stroke-width="1.1" stroke-dasharray="4,3"/>
          <circle cx="112" cy="117" r="8" fill="none" stroke="#d9d9d9" stroke-width="1"/>
          <text x="150" y="113" text-anchor="middle" font-size="9" font-weight="700" fill="#bfbfbf">CAM 03</text>
          <text x="150" y="126" text-anchor="middle" font-size="8" fill="#bfbfbf">—</text>
          <rect x="618" y="290" width="98" height="54" rx="8" fill="#f5f5f5" stroke="#d9d9d9" stroke-width="1.1" stroke-dasharray="4,3"/>
          <circle cx="642" cy="317" r="8" fill="none" stroke="#d9d9d9" stroke-width="1"/>
          <text x="680" y="313" text-anchor="middle" font-size="9" font-weight="700" fill="#bfbfbf">CAM 04</text>
          <text x="680" y="326" text-anchor="middle" font-size="8" fill="#bfbfbf">—</text>
        </g>
        <rect x="60" y="60" width="680" height="28" fill="#fafcff"/>
        <text x="88" y="78" font-family="JetBrains Mono" font-size="9" fill="#9aa5b5">MANZAR FORENSIC VIEWER — No active session</text>
        <rect x="610" y="66" width="118" height="18" rx="4" fill="#f5f5f5" stroke="#d9d9d9" stroke-width="0.8"/>
        <circle cx="624" cy="75" r="3" fill="#d9d9d9"/>
        <text x="632" y="79" font-family="JetBrains Mono" font-size="8.5" font-weight="600" fill="#bfbfbf">WAITING</text>
      </svg>
    </div>

    <div class="flex justify-center gap-24 wrap" style="padding-bottom:56px;">
      <div class="text-center"><div class="mono conf" style="font-size:26px; color:var(--text-4);">—</div><div class="text-3 text-xs">Average confidence</div></div>
      <div class="text-center"><div class="mono conf" style="font-size:26px; color:var(--text-4);">—</div><div class="text-3 text-xs">Camera sources</div></div>
      <div class="text-center"><div class="mono conf" style="font-size:26px; color:var(--text-4);">—</div><div class="text-3 text-xs">Reconstruction preview</div></div>
      <div class="text-center"><div class="mono conf" style="font-size:26px; color:var(--text-4);">—</div><div class="text-3 text-xs">Neutral reporting</div></div>
    </div>

    <div class="text-center mb-32">
      <span class="tag tag-gray mb-12">End-to-end workflow</span>
      <h2 style="font-size:32px; margin:10px 0 8px;">From Scene to Grounded Answers</h2>
      <p class="text-3">No training required for participants. Technical depth is reserved for investigators and officers.</p>
    </div>
    <div class="grid grid-5 mb-32">
      <div class="card card-hover card-pad"><div class="tag tag-blue mb-12" style="font-size:13px; height:30px; width:30px; border-radius:8px; justify-content:center;">01</div><h4 style="font-size:15px; margin-bottom:6px;">Capture</h4><p class="text-3 text-xs" style="line-height:1.6;">Any smartphone joins via QR and photographs the scene from an independent angle.</p></div>
      <div class="card card-hover card-pad"><div class="tag tag-cyan mb-12" style="font-size:13px; height:30px; width:30px; border-radius:8px; justify-content:center;">02</div><h4 style="font-size:15px; margin-bottom:6px;">Coverage Check</h4><p class="text-3 text-xs" style="line-height:1.6;">MANZAR verifies front/left/right/back coverage before reconstruction — new in v5.1.</p></div>
      <div class="card card-hover card-pad"><div class="tag tag-green mb-12" style="font-size:13px; height:30px; width:30px; border-radius:8px; justify-content:center;">03</div><h4 style="font-size:15px; margin-bottom:6px;">Reconstruct</h4><p class="text-3 text-xs" style="line-height:1.6;">AI builds a photogrammetric 3D model from captured photos with full evidence chain transparency.</p></div>
      <div class="card card-hover card-pad"><div class="tag tag-amber mb-12" style="font-size:13px; height:30px; width:30px; border-radius:8px; justify-content:center;">04</div><h4 style="font-size:15px; margin-bottom:6px;">Verify</h4><p class="text-3 text-xs" style="line-height:1.6;">Each evidence item is cross-checked across independent camera sources.</p></div>
      <div class="card card-hover card-pad" style="border-color:var(--primary-border); background:var(--primary-bg);"><div class="tag tag-blue mb-12" style="font-size:13px; height:30px; width:30px; border-radius:8px; justify-content:center;">05</div><h4 style="font-size:15px; margin-bottom:6px;">Ask MANZAR 💬</h4><p class="text-2 text-xs" style="line-height:1.6;">Interrogate the session's evidence conversationally instead of just reading a static report.</p></div>
    </div>

    <div class="card card-pad-lg mb-32">
      <div class="flex items-center justify-between mb-24 wrap gap-12">
        <div><span class="tag tag-blue mb-8">System Architecture</span><h3 style="font-size:20px;">One session, two ways to understand it</h3></div>
        <p class="text-3 text-sm" style="max-width:380px;">Every session builds a structured evidence graph. Read it as a static report, or ask it questions directly.</p>
      </div>
      <div class="flow">
        <div class="flow-node">Multi-Phone Capture<span class="sub">QR-joined · 2–4 photos per device</span></div>
        <div class="flow-arrow">↓</div>
        <div class="flow-node">Coverage Check<span class="sub">front / left / right / back — missing angle prompted by name</span></div>
        <div class="flow-arrow">↓</div>
        <div class="flow-node">AI Detection + 3D Reconstruction<span class="sub">Fine-Tuned Vision AI detection ‖ COLMAP → OpenMVS mesh</span></div>
        <div class="flow-arrow">↓</div>
        <div class="flow-node">Cross-Angle Verification<span class="sub">independent camera corroboration</span></div>
        <div class="flow-arrow">↓</div>
        <div class="flow-node accent">Structured Evidence Graph / Session Data</div>
        <div class="flow-arrow">↓</div>
        <div class="flow-split mt-8">
          <div class="flow-branch"><div class="flow-node" style="max-width:none;">Static Report</div></div>
          <div class="flow-branch">
            <div class="flow-node cyan" style="max-width:none;">Ask MANZAR 💬</div>
            <div class="flow-arrow">↓</div>
            <div class="flow-node cyan" style="max-width:none;">Session-Grounded Answers</div>
            <div class="flow-arrow">↓</div>
            <div class="flow-node cyan" style="max-width:none;">Evidence Sources</div>
          </div>
        </div>
      </div>
      <div class="mt-24"><a class="btn btn-primary" data-goto="ask-manzar">Try Ask MANZAR →</a></div>
    </div>

    <div class="grid grid-2 mb-32">
      <div class="card card-pad-lg"><span class="tag tag-amber mb-12">New in v5.1</span><h3 style="font-size:18px; margin-bottom:8px;">Coverage-Aware Capture</h3><p class="text-2 text-sm" style="line-height:1.7;">Before reconstruction starts, MANZAR checks whether front, left, right, and back angles were actually captured — using pose estimates, not just image count. If a view is missing, contributors are asked for that specific angle by name.</p><a class="btn btn-sm mt-16" data-goto="evidence-upload">See Evidence Upload →</a></div>
      
    </div>

    <div class="text-center mb-24"><h2 style="font-size:28px; margin-bottom:8px;">Built for Field Professionals</h2><p class="text-3">Every role in the investigation workflow is supported.</p></div>
    <div class="grid grid-4 mb-56">
      <div class="card card-hover card-pad text-center">
        <div style="width:52px;height:52px;margin:0 auto 12px;border-radius:14px;background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 100%);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(37,99,235,0.25);">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        </div>
        <h5 style="font-size:14px; margin:0 0 4px;">Traffic Police</h5>
        <p class="text-3 text-xs">Scene documentation &amp; FIR attachment</p>
      </div>
      <div class="card card-hover card-pad text-center">
        <div style="width:52px;height:52px;margin:0 auto 12px;border-radius:14px;background:linear-gradient(135deg,#065f46 0%,#10b981 100%);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(16,185,129,0.25);">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4 8 4v14"/><path d="M9 10h.01"/><path d="M15 10h.01"/><path d="M9 14h.01"/><path d="M15 14h.01"/></svg>
        </div>
        <h5 style="font-size:14px; margin:0 0 4px;">Insurance Investigators</h5>
        <p class="text-3 text-xs">Objective evidence for claims processing</p>
      </div>
      <div class="card card-hover card-pad text-center">
        <div style="width:52px;height:52px;margin:0 auto 12px;border-radius:14px;background:linear-gradient(135deg,#9a3412 0%,#f97316 100%);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(249,115,22,0.25);">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8a2 2 0 0 0 2-2V10l-5-6H9L4 10v9a2 2 0 0 0 2 2z"/><path d="M12 11v6"/><path d="M9 14h6"/></svg>
        </div>
        <h5 style="font-size:14px; margin:0 0 4px;">First Responders</h5>
        <p class="text-3 text-xs">Quick collaborative scene capture</p>
      </div>
      <div class="card card-hover card-pad text-center">
        <div style="width:52px;height:52px;margin:0 auto 12px;border-radius:14px;background:linear-gradient(135deg,#4c1d95 0%,#8b5cf6 100%);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(139,92,246,0.25);">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
        </div>
        <h5 style="font-size:14px; margin:0 0 4px;">Forensic Officers</h5>
        <p class="text-3 text-xs">3D scene reconstruction &amp; analysis</p>
      </div>
    </div>

    <div class="card card-pad-lg text-center mb-56" style="background:linear-gradient(135deg,var(--primary-bg),var(--cyan-bg)); border-color:var(--primary-border);">
      <h2 style="font-size:28px; margin-bottom:10px;">Ready to investigate?</h2>
      <p class="text-2" style="max-width:480px; margin:0 auto 24px;">Create a session, share the QR code, and begin capturing cross-verified evidence in under 60 seconds.</p>
      <div class="flex justify-center gap-12 wrap">
        <a class="btn btn-primary btn-lg" data-goto="create-session">Create Investigation Session</a>
        <a class="btn btn-lg" data-goto="session-history">View Sessions</a>
      </div>
    </div>
  </div>

  <footer class="footer">
    <div class="footer-inner">
      <span class="logo"><span class="logo-word" style="font-size:15px;">MAN<span>ZAR</span></span></span>
      <span class="mono text-4" style="font-size:11px;">© 2026 MANZAR — AI-Powered Traffic Accident Reconstruction · SRS v5.1</span>
      <div class="flex gap-16"><span class="text-3 text-xs">Privacy</span><span class="text-3 text-xs">Terms</span><span class="text-3 text-xs">Contact</span><span class="text-3 text-xs">Docs</span></div>
    </div>
  </footer>
</section>

<!-- ============================================================= -->
<!-- 2. CREATE SESSION -->
<!-- ============================================================= -->
<section class="screen" data-screen="create-session">
  <div class="container" style="padding-top:36px; padding-bottom:56px;">
    <div class="crumb mb-24"><a data-goto="landing">Home</a><span>›</span><span class="current">Create Session</span></div>
    <div class="grid" style="grid-template-columns:3fr 2fr;">
      <div>
        <h1 style="font-size:30px; margin-bottom:6px;">Create Accident Scene Session</h1>
        <p class="text-2 mb-24">Generate a collaborative evidence capture session and invite participants.</p>
        <div class="card card-pad-lg">
          <div class="field"><label>Session Name</label><input class="input" id="session-name" placeholder="e.g. Accident — Main Street, City" /></div>
          <div class="field"><label>Accident Location</label><input class="input" id="session-location" placeholder="Full address or landmark" /></div>
          <div class="grid grid-2">
            <div class="field"><label>Incident Reference No.</label><input class="input mono" id="session-ref" placeholder="FIR-YYYY-MM-XXX-0000" /></div>
            <div class="field"><label>Date &amp; Time</label><input class="input mono" id="session-datetime" type="datetime-local" /></div>
          </div>
          <div class="field"><label>Officer / Investigator Name</label><input class="input" id="session-officer" placeholder="Name and rank" /></div>
          <div class="field mb-0"><label>Notes <span class="hint">(optional)</span></label><textarea class="textarea" id="session-notes" rows="3" placeholder="Initial observations, road conditions, weather, etc."></textarea></div>
          <hr class="hr" />
          <div class="alert alert-info mb-16">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <p>Coverage-aware capture (v5.1): MANZAR will track front / left / right / back angles as devices join, and prompt for any that are missing before reconstruction starts.</p>
          </div>
          <a class="btn btn-primary btn-block" style="height:46px; font-size:15px;" data-goto="qr-join">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="5" height="5"/><rect x="16" y="3" width="5" height="5"/><rect x="3" y="16" width="5" height="5"/><rect x="14" y="14" width="3" height="3"/><path d="M14 19h5"/><path d="M19 14v5"/></svg>
            Create Session &amp; Generate QR Code
          </a>
        </div>
      </div>
      <div class="flex-col gap-20">
        <div class="card card-pad card-cyan">
          <h3 class="fw-700 mb-12" style="color:#08979c; font-size:15px; display:flex; align-items:center; gap:8px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>How participants join</h3>
          <p class="text-2 text-sm mb-16" style="line-height:1.65;">Once you create the session, a QR code is generated. Ask drivers, passengers, witnesses, and responders to scan it and capture the scene from independent angles.</p>
          <div class="flex items-center justify-center gap-12 mb-8" style="padding:10px 0;"><span style="font-size:20px;">👮</span><span style="color:var(--primary);">→</span><span style="font-size:20px;">🚗</span><span style="color:var(--primary);">→</span><span style="font-size:20px;">👁️</span><span style="color:var(--primary);">→</span><span style="font-size:20px;">📱</span></div>
          <p class="text-3 text-xs text-center">Officer → Drivers → Witnesses → All capture independently</p>
        </div>
        <div class="card card-pad">
          <h3 class="fw-700 mb-12" style="font-size:15px;">AI will detect</h3>
          <div class="flex-col gap-10">
            <div class="flex items-center gap-10"><span class="tag tag-red" style="width:26px; height:26px; border-radius:8px; justify-content:center;">🚗</span><span class="text-sm">Vehicle Damage</span><span class="tag tag-blue" style="margin-left:auto;">Auto</span></div>
            <div class="flex items-center gap-10"><span class="tag tag-amber" style="width:26px; height:26px; border-radius:8px; justify-content:center;">⟿</span><span class="text-sm">Skid Marks</span><span class="tag tag-blue" style="margin-left:auto;">Auto</span></div>
            <div class="flex items-center gap-10"><span class="tag tag-gray" style="width:26px; height:26px; border-radius:8px; justify-content:center;">◦</span><span class="text-sm">Debris Field</span><span class="tag tag-blue" style="margin-left:auto;">Auto</span></div>
            <div class="flex items-center gap-10"><span class="tag tag-red" style="width:26px; height:26px; border-radius:8px; justify-content:center;">✕</span><span class="text-sm">Point of Impact</span><span class="tag tag-blue" style="margin-left:auto;">Auto</span></div>
          </div>
        </div>
        <div class="card card-pad">
          <div class="flex items-center justify-between mb-12"><h3 class="fw-700" style="font-size:15px;">Recent Sessions</h3><a class="btn btn-text btn-sm" data-goto="session-history">View all</a></div>
          <div class="flex-col">
            <div class="text-center text-3 text-sm" style="padding:20px 0;">No recent sessions. Create one to get started.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ============================================================= -->
<!-- 3. CAPTURE CHOICE -->
<!-- ============================================================= -->
<section class="screen" data-screen="capture-choice">
  <div class="container" style="padding-top:48px; padding-bottom:56px;">
    <div class="crumb mb-24"><a data-goto="landing">Home</a><span>›</span><span class="current">Create Session</span><span>›</span><span class="current">Capture Choice</span></div>
    <div class="text-center mb-32">
      <h1 style="font-size:30px; margin-bottom:10px;">How do you want to capture evidence?</h1>
      <p class="text-2" style="max-width:560px; margin:0 auto; font-size:15px;">Choose how photos will be added to this investigation session.</p>
    </div>
    <div class="grid grid-2" style="max-width:800px; margin:0 auto; align-items:stretch;">
      <!-- Option A: Mobile/QR -->
      <div class="card card-pad-lg card-hover" style="cursor:pointer; display:flex; flex-direction:column;" onclick="goto('qr-join')">
        <div style="width:64px; height:64px; border-radius:16px; background:linear-gradient(135deg,#e6f7ff,#bae7ff); display:flex; align-items:center; justify-content:center; margin-bottom:20px;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1677ff" stroke-width="2"><rect x="3" y="3" width="5" height="5"/><rect x="16" y="3" width="5" height="5"/><rect x="3" y="16" width="5" height="5"/><rect x="14" y="14" width="3" height="3"/><path d="M14 19h5"/><path d="M19 14v5"/></svg>
        </div>
        <h2 style="font-size:20px; margin-bottom:8px;">Upload from Mobile Device</h2>
        <p class="text-2 text-sm mb-20" style="line-height:1.65; flex:1;">Show a QR code so drivers, witnesses, or other officers can scan and upload photos directly from their phones.</p>
        <button class="btn btn-primary btn-block" style="height:46px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="5" height="5"/><rect x="16" y="3" width="5" height="5"/><rect x="3" y="16" width="5" height="5"/><rect x="14" y="14" width="3" height="3"/><path d="M14 19h5"/><path d="M19 14v5"/></svg>
          Generate QR Code
        </button>
      </div>
      <!-- Option B: Direct Upload -->
      <div class="card card-pad-lg card-hover" style="cursor:pointer; display:flex; flex-direction:column;" onclick="goto('direct-upload')">
        <div style="width:64px; height:64px; border-radius:16px; background:linear-gradient(135deg,#f6ffed,#b7eb8f); display:flex; align-items:center; justify-content:center; margin-bottom:20px;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#389e0d" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        </div>
        <h2 style="font-size:20px; margin-bottom:8px;">Upload from This Device</h2>
        <p class="text-2 text-sm mb-20" style="line-height:1.65; flex:1;">Upload accident photos directly from this computer. You can select angles manually or let AI auto-detect them.</p>
        <button class="btn btn-primary btn-block" style="height:46px; background:#389e0d; border-color:#389e0d;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload Photos Here
        </button>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================= -->
<!-- 4. QR JOIN -->
<!-- ============================================================= -->
<section class="screen" data-screen="qr-join">
  <div class="container" style="padding-top:40px; padding-bottom:56px;">
    <div class="text-center mb-32">
      <h1 style="font-size:32px; margin-bottom:10px;">Capture the Scene Before It Changes</h1>
      <p class="text-2" style="max-width:640px; margin:0 auto; font-size:16px;">Ask drivers, passengers, witnesses, and responders to scan this code and capture the accident from different angles.</p>
    </div>
    <div class="grid" style="grid-template-columns:1fr 2fr; align-items:start;">
      <div class="flex-col items-center">
        <div class="card card-pad" style="border-color:var(--primary-border);">
          <img id="qr-code-img" src="" alt="QR Code" style="width:220px; height:220px; display:none; border-radius:4px;" />
          <div id="qr-placeholder" style="width:220px; height:220px; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:8px; color:var(--text-3); font-size:13px;">
            <div style="font-size:36px;">📱</div>
            <div>Create a session to<br/>generate QR code</div>
          </div>
        </div>
        <div class="text-center mt-16">
          <div class="mono text-xs text-3">SESSION ID</div>
          <div class="mono fw-700" style="font-size:19px; color:var(--primary); letter-spacing:.06em;">—</div>
          <div class="text-2 text-sm mt-4" id="qr-session-name">Create a session to generate ID</div>
        </div>
        <div class="card card-pad card-cyan mt-20" style="width:100%;">
          <div class="text-center mb-12"><div class="mono fw-700" style="font-size:30px; color:#08979c;">0 <span class="text-lg text-3" style="font-weight:400;">/ 0</span></div><div class="text-2 text-sm">Devices Connected</div></div>
          <div class="progress"><div class="progress-bar" style="width:0%; background:linear-gradient(90deg,#13c2c2,#1677ff);"></div></div>
          <div class="flex justify-between mt-8"><span class="mono text-xs text-3">0°</span><span class="mono text-xs text-3">360° coverage</span></div>
        </div>
        <a class="btn btn-primary btn-block mt-20" style="height:46px;" data-goto="evidence-upload" id="btn-continue-upload">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Continue to Evidence Upload
        </a>
        <a class="btn btn-text btn-block mt-8" data-goto="mobile-join">Preview Mobile View</a>
      </div>
      <div>
        <div class="card card-pad-lg">
          <div class="flex items-center justify-between mb-20"><h2 style="font-size:17px;">Connected Devices</h2><span class="flex items-center gap-8 text-sm fw-600" style="color:var(--text-3);"><span class="status-dot" style="background:var(--text-4);"></span>Waiting</span></div>
          <div class="flex-col gap-10" id="qr-device-list">
            <div class="text-center text-3 text-sm" style="padding:28px 0;">
              <div style="font-size:32px; margin-bottom:8px;">📱</div>
              No devices connected yet.<br/>Share the QR code to invite participants.
            </div>
          </div>
          <div class="alert alert-info mt-20"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg><p>For best 3D reconstruction results, aim for at least 4 devices capturing from different angles. Photos from front / left / right / back angles are needed before reconstruction begins.</p></div>
        </div>

        <!-- Live Captured Photos Section -->
        <div class="card card-pad-lg mt-20">
          <div class="flex items-center justify-between mb-16">
            <h3 class="fw-700" style="font-size:15px;">Captured Photos</h3>
            <span class="tag tag-gray" id="qr-photo-count">0 photos</span>
          </div>
          <div id="qr-photo-list" class="flex-col gap-8">
            <div class="text-center text-3 text-sm" style="padding:20px 0;">No photos captured yet. Waiting for devices to upload...</div>
          </div>
          <!-- Angle Coverage Status -->
          <div class="grid grid-4 gap-8 mt-16" id="qr-angle-coverage">
            <div class="text-center" style="padding:8px; border-radius:8px; background:var(--fill-2); border:1px solid var(--border-2);">
              <div class="text-xs fw-600">Front</div>
              <div class="tag tag-gray mt-4" style="font-size:9px;" id="qr-angle-front">Missing</div>
            </div>
            <div class="text-center" style="padding:8px; border-radius:8px; background:var(--fill-2); border:1px solid var(--border-2);">
              <div class="text-xs fw-600">Left</div>
              <div class="tag tag-gray mt-4" style="font-size:9px;" id="qr-angle-left">Missing</div>
            </div>
            <div class="text-center" style="padding:8px; border-radius:8px; background:var(--fill-2); border:1px solid var(--border-2);">
              <div class="text-xs fw-600">Right</div>
              <div class="tag tag-gray mt-4" style="font-size:9px;" id="qr-angle-right">Missing</div>
            </div>
            <div class="text-center" style="padding:8px; border-radius:8px; background:var(--fill-2); border:1px solid var(--border-2);">
              <div class="text-xs fw-600">Rear</div>
              <div class="tag tag-gray mt-4" style="font-size:9px;" id="qr-angle-rear">Missing</div>
            </div>
          </div>
        </div>

        <div class="card card-pad-lg mt-20">
          <h3 class="fw-700 mb-16" style="font-size:15px;">Angle Coverage Map</h3>
          <div class="flex justify-center">
            <svg width="240" height="240" viewBox="-120 -120 240 240">
              <circle r="100" fill="none" stroke="var(--border-2)" stroke-width="1"/><circle r="70" fill="none" stroke="var(--border-2)" stroke-width="1"/><circle r="40" fill="none" stroke="var(--border-2)" stroke-width="1"/>
              <text x="0" y="-108" text-anchor="middle" fill="#9aa5b5" font-size="9" font-family="JetBrains Mono">0°</text>
              <text x="108" y="4" text-anchor="middle" fill="#9aa5b5" font-size="9" font-family="JetBrains Mono">90°</text>
              <text x="0" y="112" text-anchor="middle" fill="#9aa5b5" font-size="9" font-family="JetBrains Mono">180°</text>
              <text x="-108" y="4" text-anchor="middle" fill="#9aa5b5" font-size="9" font-family="JetBrains Mono">270°</text>
              <circle cx="0" cy="0" r="8" fill="rgba(255,77,79,0.15)" stroke="#ff4d4f" stroke-width="1.5"/><circle cx="0" cy="0" r="3" fill="#ff4d4f"/>
              <text x="0" y="18" text-anchor="middle" fill="#cf1322" font-size="7" font-family="JetBrains Mono">SCENE</text>
              <text x="0" y="36" text-anchor="middle" fill="#9aa5b5" font-size="8" font-family="JetBrains Mono">No angles captured</text>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================= -->
<!-- 4. COVERAGE CHECK (v5.1) -->
<!-- ============================================================= -->
<section class="screen" data-screen="coverage-check">
  <div class="container" style="padding-top:36px; padding-bottom:56px;">
    <div class="crumb mb-20"><a data-goto="qr-join">QR Join</a><span>›</span><span class="current">Coverage Check</span></div>
    <div class="mb-28">
      <span class="tag tag-amber tag-lg mb-12">FR-16 · New in SRS v5.1</span>
      <h1 style="font-size:28px; margin-bottom:8px;">Is there enough coverage to reconstruct the scene?</h1>
      <p class="text-2" style="max-width:720px; font-size:15px; line-height:1.7;">Before reconstruction begins, MANZAR checks whether front, left, right, and back angles are represented among the uploaded images — using pose estimates from early feature matching, not just image count. If coverage is sufficient, the pipeline proceeds straight to COLMAP → OpenMVS. If not, the specific gap is logged and contributors are asked for that angle by name.</p>
    </div>
    <div class="grid" style="grid-template-columns:1.1fr 1fr; align-items:start;">
      <div class="card card-pad-lg">
        <div class="flex items-center justify-between mb-20"><h3 style="font-size:16px;">Angle Coverage</h3><span class="tag tag-gray">0 of 4 angles captured</span></div>
        <div class="flex justify-center mb-20">
          <svg width="280" height="280" viewBox="-140 -140 280 280">
            <circle r="115" fill="none" stroke="var(--border-2)" stroke-width="1"/><circle r="80" fill="none" stroke="var(--border-2)" stroke-width="1"/><circle r="45" fill="none" stroke="var(--border-2)" stroke-width="1"/>
            <path d="M 0 0 L -45 -108 A 118 118 0 0 1 45 -108 Z" fill="rgba(217,217,217,0.12)" stroke="#d9d9d9" stroke-width="1" stroke-dasharray="5,4"/>
            <path d="M 0 0 L 45 -108 A 118 118 0 0 1 108 45 Z" fill="rgba(217,217,217,0.12)" stroke="#d9d9d9" stroke-width="1" stroke-dasharray="5,4"/>
            <path d="M 0 0 L -108 45 A 118 118 0 0 1 -45 -108 Z" fill="rgba(217,217,217,0.12)" stroke="#d9d9d9" stroke-width="1" stroke-dasharray="5,4"/>
            <path d="M 0 0 L 108 45 A 118 118 0 0 1 45 108 Z" fill="rgba(217,217,217,0.12)" stroke="#d9d9d9" stroke-width="1" stroke-dasharray="5,4"/>
            <text x="0" y="-95" text-anchor="middle" font-family="JetBrains Mono" font-size="10" font-weight="700" fill="#bfbfbf">FRONT</text>
            <text x="95" y="-30" text-anchor="middle" font-family="JetBrains Mono" font-size="10" font-weight="700" fill="#bfbfbf" transform="rotate(60,95,-30)">RIGHT</text>
            <text x="-95" y="-30" text-anchor="middle" font-family="JetBrains Mono" font-size="10" font-weight="700" fill="#bfbfbf" transform="rotate(-60,-95,-30)">LEFT</text>
            <text x="72" y="82" text-anchor="middle" font-family="JetBrains Mono" font-size="10" font-weight="700" fill="#bfbfbf">BACK</text>
            <circle cx="0" cy="0" r="7" fill="rgba(255,77,79,0.15)" stroke="#ff4d4f" stroke-width="1.5"/><circle cx="0" cy="0" r="2.5" fill="#ff4d4f"/>
          </svg>
        </div>
        <div class="flex-col gap-8">
          <div class="flex items-center justify-between" style="padding:10px 12px; border-radius:8px; background:var(--fill-2); border:1px solid var(--border-2);"><span class="text-sm fw-600">Front</span><span class="tag tag-gray">Not captured</span></div>
          <div class="flex items-center justify-between" style="padding:10px 12px; border-radius:8px; background:var(--fill-2); border:1px solid var(--border-2);"><span class="text-sm fw-600">Left</span><span class="tag tag-gray">Not captured</span></div>
          <div class="flex items-center justify-between" style="padding:10px 12px; border-radius:8px; background:var(--fill-2); border:1px solid var(--border-2);"><span class="text-sm fw-600">Right</span><span class="tag tag-gray">Not captured</span></div>
          <div class="flex items-center justify-between" style="padding:10px 12px; border-radius:8px; background:var(--fill-2); border:1px solid var(--border-2);"><span class="text-sm fw-600">Back</span><span class="tag tag-gray">Not captured</span></div>
        </div>
      </div>
      <div class="flex-col gap-16">
        <div class="alert alert-warning"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><p><strong>Missing view detected:</strong> no rear angle has been captured yet. This gap is logged specifically — not surfaced as a generic error — so the request to contributors is actionable.</p></div>
        <div class="card card-pad-lg">
          <h3 style="font-size:15px; margin-bottom:14px;">Request the missing angle</h3>
          <div class="flex items-center gap-14 mb-16" style="padding:14px; border-radius:10px; background:var(--fill-2); border:1px solid var(--border-2);"><div class="tag tag-blue" style="width:40px; height:40px; border-radius:10px; justify-content:center; font-size:18px;">📱</div><div class="flex-1"><div class="text-sm fw-600">No active request</div><div class="text-3 text-xs mt-4">Waiting for participants to join and capture angles.</div></div></div>
          <div class="flex items-center justify-between mb-8"><span class="text-xs text-3">No active session</span><span class="mono text-xs text-3">—</span></div>
          <div class="progress progress-thin"><div class="progress-bar" style="width:0%;"></div></div>
        </div>
        <div class="card card-pad-lg">
          <h3 style="font-size:15px;">If no more photos arrive in time</h3>
          <p class="text-3 text-xs mb-16 mt-4">The flow loops back to the coverage check if a new photo is supplied. Otherwise, two paths are available:</p>
          <div class="grid grid-2 gap-12">
            <div class="card card-dashed card-pad" style="border-color:var(--border);"><div class="tag tag-gray mb-10">Decline completion</div><div class="text-sm fw-600 mb-4">Partial Model</div><p class="text-3 text-xs" style="line-height:1.6;">Gaps are left visibly blank rather than filled with a guess.</p></div>
            
          </div>
        </div>
        <div class="flex gap-10">
          <a class="btn btn-block justify-center" data-goto="qr-join">← Wait for More Photos</a>
          
        </div>
        <a class="btn btn-text btn-block justify-center text-3" data-goto="evidence-upload">Skip — reconstruct with 3 of 4 angles only</a>
      </div>
    </div>
    <div class="card card-pad-lg mt-32">
      <h3 style="font-size:16px; margin-bottom:16px;">Full Branch Logic — SRS §9.1</h3>
      <div class="grid grid-4 gap-16">
        <div class="card card-pad" style="text-align:center;"><div class="tag tag-blue mb-10">1</div><div class="text-sm fw-600 mb-4">Coverage Check</div><p class="text-3 text-xs">Front/left/right/back represented?</p></div>
        <div class="card card-pad" style="text-align:center;"><div class="tag tag-amber mb-10">2</div><div class="text-sm fw-600 mb-4">Missing View Logged</div><p class="text-3 text-xs">Specific gap named, not generic error</p></div>
        
        <div class="card card-pad" style="text-align:center;"><div class="tag tag-green mb-10">3</div><div class="text-sm fw-600 mb-4">Final Model</div><p class="text-3 text-xs">Captured geometry only</p></div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================= -->


<!-- ============================================================= -->
<!-- 6. MOBILE JOIN -->
<!-- ============================================================= -->
<section class="screen" data-screen="mobile-join">
  <div class="flex items-center justify-center" style="min-height:100vh; padding:24px 16px; background:var(--fill);">
    <div style="max-width:480px; width:100%;">
      <div class="text-center mb-24">
        <div style="width:64px; height:64px; margin:0 auto 16px; border-radius:16px; background:linear-gradient(135deg,#1677ff,#13c2c2); display:flex; align-items:center; justify-content:center;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        </div>
        <h1 style="font-size:22px; margin-bottom:8px;">Evidence Capture</h1>
        <p class="text-2" style="font-size:14px;">Session <span class="mono fw-600" id="mobile-session-id">—</span></p>
      </div>

      <div class="card card-pad-lg mb-20">
        <h3 class="fw-600 mb-12" style="font-size:15px;">Select Angle (Optional)</h3>
        <p class="text-3 text-xs mb-12">Choose the angle you're capturing, or leave as "Auto" for AI detection.</p>
        <div class="grid grid-2 gap-8" id="angle-selector">
          <button class="angle-btn" data-angle="front" style="padding:12px; border-radius:10px; border:2px solid var(--border); background:var(--fill-2); font-size:14px; font-weight:500;">Front</button>
          <button class="angle-btn" data-angle="left" style="padding:12px; border-radius:10px; border:2px solid var(--border); background:var(--fill-2); font-size:14px; font-weight:500;">Left</button>
          <button class="angle-btn" data-angle="right" style="padding:12px; border-radius:10px; border:2px solid var(--border); background:var(--fill-2); font-size:14px; font-weight:500;">Right</button>
          <button class="angle-btn" data-angle="rear" style="padding:12px; border-radius:10px; border:2px solid var(--border); background:var(--fill-2); font-size:14px; font-weight:500;">Rear</button>
        </div>
        <button class="angle-btn selected" data-angle="auto" style="width:100%; margin-top:8px; padding:12px; border-radius:10px; border:2px solid var(--primary); background:var(--primary-bg); font-size:14px; font-weight:600; color:var(--primary);">Auto Detect (AI)</button>
      </div>

      <button id="mobile-upload-btn" class="btn btn-primary btn-block" style="height:52px; font-size:16px; border-radius:14px; margin-bottom:12px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Upload Photos
      </button>

      <button id="mobile-done-btn" class="btn btn-block" style="height:48px; font-size:15px; border-radius:14px; margin-bottom:12px; display:none; background:var(--success); color:#fff; border:none;">
        ✓ Done Uploading — Submit
      </button>

      <div id="upload-status" class="text-center text-3 text-xs" style="padding:12px 0;"></div>
    </div>
  </div>
</section>

<section class="screen" data-screen="mobile-thanks">
  <div class="flex items-center justify-center" style="min-height:100vh; padding:24px 16px; background:var(--fill);">
    <div style="max-width:480px; width:100%; text-align:center;">
      <div style="width:80px; height:80px; margin:0 auto 24px; border-radius:50%; background:linear-gradient(135deg,#52c41a,#73d13d); display:flex; align-items:center; justify-content:center;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h1 style="font-size:24px; margin-bottom:12px;">Thank You!</h1>
      <p class="text-2" style="font-size:15px; line-height:1.6; margin-bottom:24px;">Your photos have been submitted and are being analyzed. The investigation team will review the evidence shortly.</p>
      <div class="card card-pad" style="background:var(--primary-bg); border-color:var(--primary-border);">
        <p class="text-sm" style="color:var(--primary); font-weight:500;">You can close this page now.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================= -->
<!-- 7. MOBILE CAMERA -->
<!-- ============================================================= -->
<section class="screen" data-screen="mobile-camera">
  <div class="flex items-center justify-center" style="min-height:100vh; padding:32px 16px; background:var(--fill);">
    <div>
      <div class="phone" style="border-color:#0b1220; background:#0b1220;">
        <div style="position:relative; height:800px; border-radius:28px; overflow:hidden; background:#f0f4f9;">
          <svg viewBox="0 0 390 800" style="position:absolute; inset:0; width:100%; height:100%;">
            <rect width="390" height="800" fill="#eef3fa"/><rect y="420" width="390" height="380" fill="#e2e9f2"/>
            <line x1="195" y1="420" x2="195" y2="800" stroke="#c7d1e0" stroke-width="2" stroke-dasharray="14,10"/>
            <g transform="translate(70,470)"><polygon points="10,60 150,60 165,32 -5,32" fill="#cfe0ff" stroke="#1677ff" stroke-width="1.4"/><polygon points="-5,32 165,32 145,6 15,6" fill="#b7d3ff" stroke="#1677ff" stroke-width="1.4"/></g>
            <g transform="translate(260,510)"><ellipse cx="20" cy="46" rx="20" ry="7" fill="#22314a" opacity=".25"/><polygon points="6,40 68,40 62,20 12,20" fill="#efe0ff" stroke="#722ed1" stroke-width="1.2"/></g>
            <path d="M 90 780 Q 140 690 175 620 Q 195 580 215 540" stroke="#faad14" stroke-width="4" fill="none" stroke-dasharray="9,7" stroke-linecap="round" opacity=".8"/>
          </svg>
          <div class="flex items-center justify-between" style="position:absolute; top:0; left:0; right:0; padding:16px 18px 8px; background:linear-gradient(180deg,rgba(255,255,255,.9),transparent);"><span class="mono text-xs fw-600">--:--</span><span class="tag tag-gray">IDLE</span><span class="mono text-xs">📷</span></div>
          <div style="position:absolute; top:58px; left:26px; width:26px; height:26px; border-top:2px solid rgba(11,18,32,.35); border-left:2px solid rgba(11,18,32,.35);"></div>
          <div style="position:absolute; top:58px; right:26px; width:26px; height:26px; border-top:2px solid rgba(11,18,32,.35); border-right:2px solid rgba(11,18,32,.35);"></div>
          <div style="position:absolute; bottom:150px; left:26px; width:26px; height:26px; border-bottom:2px solid rgba(11,18,32,.35); border-left:2px solid rgba(11,18,32,.35);"></div>
          <div style="position:absolute; bottom:150px; right:26px; width:26px; height:26px; border-bottom:2px solid rgba(11,18,32,.35); border-right:2px solid rgba(11,18,32,.35);"></div>
          <div style="position:absolute; left:18px; right:18px; top:66px;"><div class="text-center" style="padding:9px 14px; border-radius:12px; background:rgba(11,18,32,.06); border:1px solid rgba(11,18,32,.1);"><span style="font-size:13px; font-weight:600; color:var(--text-3);">Start a session to begin capturing</span></div></div>
          <div class="flex items-center justify-between" style="position:absolute; left:18px; right:18px; top:112px;"><span class="tag tag-gray">Waiting</span><span class="mono text-xs text-3">—</span></div>
          <div style="position:absolute; left:18px; right:18px; bottom:186px;"><div class="flex items-center justify-between mb-6"><span class="mono text-xs text-3">0 / 0 captures</span><span class="mono text-xs text-3">0%</span></div><div class="progress"><div class="progress-bar" style="width:0%;"></div></div></div>
          <div style="position:absolute; bottom:0; left:0; right:0; padding:18px 24px 30px; background:linear-gradient(0deg,rgba(255,255,255,.96),transparent);">
            
            <div class="flex items-center justify-between">
              <div style="width:46px; height:46px; border-radius:12px; background:#fff; border:1px solid var(--border-2); display:flex; align-items:center; justify-content:center; font-size:18px;">📁</div>
              <a data-goto="evidence-upload" style="width:78px; height:78px; border-radius:50%; background:rgba(11,18,32,.06); border:3px solid #0b1220; display:flex; align-items:center; justify-content:center;"><span style="width:56px; height:56px; border-radius:50%; background:#0b1220; display:block;"></span></a>
              <div style="width:46px; height:46px; border-radius:12px; background:#fff; border:1px solid var(--border-2); display:flex; align-items:center; justify-content:center; font-size:18px;">⚡</div>
            </div>
          </div>
        </div>
      </div>
      <div class="flex justify-center gap-10 mt-16">
        <a class="btn btn-text" data-goto="mobile-join">← Back</a>
        <a class="btn btn-primary btn-sm" data-goto="evidence-upload">Done Capturing →</a>
      </div>
    </div>
  </div>
</section>


<!-- ============================================================= -->
<!-- 5. DIRECT UPLOAD -->
<!-- ============================================================= -->
<section class="screen" data-screen="direct-upload">
  <div class="container" style="padding-top:32px; padding-bottom:56px;">
    <div class="crumb mb-24"><a data-goto="landing">Home</a><span>›</span><span class="current">Create Session</span><span>›</span><span class="current">Upload from This Device</span></div>
    <div class="flex items-center justify-between mb-24 wrap gap-12">
      <div><h1 style="font-size:26px;">Upload Evidence Photos</h1><p class="text-2 text-sm mt-4">Select accident photos from this computer. Set angles manually or use AI auto-detection.</p></div>
      <a class="btn" data-goto="capture-choice">← Back to Capture Choice</a>
    </div>

    <!-- Upload dropzone -->
    <div id="du-dropzone" class="card card-dashed card-pad" style="text-align:center; padding:48px 24px; cursor:pointer; border-style:dashed; border-width:2px;">
      <div style="font-size:42px; margin-bottom:12px;">📁</div>
      <div class="text-sm fw-600 mb-4">Click or drag &amp; drop photos here</div>
      <div class="text-3 text-xs">Supports JPG, PNG. Select multiple photos at once.</div>
      <input type="file" id="du-file-input" accept="image/*" multiple style="display:none;" />
    </div>

    <!-- Selected photos grid -->
    <div class="flex items-center justify-between mt-28 mb-14">
      <h2 style="font-size:16px;">Selected Photos <span class="text-3 text-sm" id="du-count">(0)</span></h2>
      <button class="btn btn-sm" id="du-clear-all" style="display:none;">Clear All</button>
    </div>
    <div id="du-photo-grid" class="grid grid-4" style="gap:16px;">
      <div class="card card-dashed card-pad" id="du-empty-state" style="grid-column:1/-1; text-align:center; padding:40px 20px;">
        <div class="text-3 text-sm">No photos selected yet.</div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex gap-12 mt-28 wrap">
      <button class="btn btn-primary btn-lg" id="du-start-btn" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        Start Investigation
      </button>
      <button class="btn btn-lg" id="du-auto-detect-all" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        Auto-Detect All Angles
      </button>
    </div>
    <div id="du-status" class="mt-16 text-sm"></div>
  </div>
</section>

<!-- ============================================================= -->
<!-- 8. EVIDENCE UPLOAD -->
<!-- ============================================================= -->
<section class="screen" data-screen="evidence-upload">
  <div class="container" style="padding-top:32px; padding-bottom:56px;">
    <div class="flex items-center justify-between mb-24 wrap gap-12">
      <div><h1 style="font-size:24px;">Live Evidence Capture</h1><p class="text-2 text-sm mt-4" id="eu-session-info">No active session — create one to begin.</p></div>
      <a class="btn btn-primary" data-goto="ai-processing"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>Begin Reconstruction</a>
    </div>
    <div id="reconstruction-notice" class="alert alert-info mb-20" role="status">
      Upload at least two overlapping photos before starting reconstruction.
    </div>
    <div class="grid grid-4 mb-28">
      <div class="card card-pad"><div class="flex items-center justify-between mb-8"><span style="font-size:18px;">📱</span><span class="mono fw-700" style="font-size:22px; color:var(--text-3);">0</span></div><div class="text-3 text-xs">Connected Devices</div></div>
      <div class="card card-pad"><div class="flex items-center justify-between mb-8"><span style="font-size:18px;">📸</span><span class="mono fw-700" style="font-size:22px; color:var(--text-3);">0</span></div><div class="text-3 text-xs">Images Received</div></div>
      <div class="card card-pad"><div class="flex items-center justify-between mb-8"><span style="font-size:18px;">◎</span><span class="mono fw-700" style="font-size:22px; color:var(--text-3);">0/4</span></div><div class="text-3 text-xs">Scene Coverage</div></div>
    </div>
    <div class="grid" style="grid-template-columns:1fr; align-items:start;">
      <div>
        <div class="flex items-center justify-between mb-14"><h2 style="font-size:16px;">Incoming Evidence</h2>
          <div class="flex gap-8" id="eu-camera-filters"><button class="btn-sm" style="border-radius:8px; border:none; background:var(--primary); color:#fff; padding:6px 12px; font-weight:600; font-size:12px;">All</button></div>
        </div>
        <div class="grid grid-4" id="eu-evidence-grid">
          <div class="card card-dashed card-pad" style="grid-column:1/-1; text-align:center; padding:48px 20px;">
            <div style="font-size:40px; margin-bottom:12px;">📷</div>
            <div class="text-sm fw-600 mb-4">Waiting for photos from connected devices</div>
            <div class="text-3 text-xs">Photos uploaded from mobile will appear here automatically.</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ============================================================= -->
<!-- 9. AI PROCESSING -->
<!-- ============================================================= -->
<section class="screen" data-screen="ai-processing">
  <div class="container" style="padding-top:32px; padding-bottom:56px;">
    <div class="text-center mb-28">
      <h1 style="font-size:26px; margin-bottom:6px;">Reconstructing the Scene</h1>
      <p class="text-2">Feature matching → pose estimation → dense cloud → mesh → fine-tuned detection → cross-angle verification</p>
      <div class="flex justify-center items-center gap-10 mt-16"><span class="mono text-sm text-3">Elapsed —</span><span class="text-3">·</span><span class="mono text-sm text-3">Target &lt;35s (NFR-4)</span></div>
    </div>
    <div class="grid" style="grid-template-columns:1.3fr 1fr; align-items:start;">
      <div class="card card-pad-lg">
        <div class="steps">
          <div class="step wait"><div class="step-icon">1</div><div class="step-rail"></div><div class="step-body"><div class="step-title">Coverage Confirmed</div><div class="step-desc">Waiting for session data</div></div></div>
          <div class="step wait"><div class="step-icon">2</div><div class="step-rail"></div><div class="step-body"><div class="step-title">Feature Extraction</div><div class="step-desc">SIFT keypoints · waiting for images</div></div></div>
          <div class="step wait"><div class="step-icon">3</div><div class="step-rail"></div><div class="step-body"><div class="step-title">Feature Matching</div><div class="step-desc">Waiting for feature extraction</div></div></div>
          <div class="step wait"><div class="step-icon">4</div><div class="step-rail"></div><div class="step-body"><div class="step-title">Camera Pose Estimation (SfM)</div><div class="step-desc">Waiting for feature matching</div></div></div>
          <div class="step wait"><div class="step-icon">5</div><div class="step-rail"></div><div class="step-body"><div class="step-title">Dense Point Cloud</div><div class="step-desc">COLMAP → OpenMVS DensifyPointCloud</div></div></div>
          <div class="step wait"><div class="step-icon">6</div><div class="step-rail"></div><div class="step-body"><div class="step-title">Mesh + Texture</div><div class="step-desc">ReconstructMesh → RefineMesh → TextureMesh</div></div></div>
          <div class="step wait"><div class="step-icon">7</div><div class="step-rail"></div><div class="step-body"><div class="step-title">Fine-Tuned Vision AI Detection</div><div class="step-desc">Fine-Tuned Vision AI · skid_mark, vehicle_damage, debris_field, point_of_impact</div></div></div>
          <div class="step wait"><div class="step-icon">8</div><div class="step-rail"></div><div class="step-body"><div class="step-title">Cross-Angle Verification</div><div class="step-desc">Qwen-VL reasoning · consistency across independent views</div></div></div>
          <div class="step wait"><div class="step-icon">9</div><div class="step-body"><div class="step-title">Report Generation</div><div class="step-desc">Structured, neutral summary</div></div></div>
        </div>
      </div>
      <div class="flex-col gap-16">
        <div class="card card-pad-lg">
          <h3 class="fw-700 mb-14" style="font-size:14px;">Evidence Detected So Far</h3>
          <div class="flex-col gap-8">
            <div class="text-center text-3 text-xs" style="padding:16px 0;">No evidence detected yet. Start reconstruction to begin analysis.</div>
          </div>
        </div>
        <div class="card card-pad-lg">
          <div class="flex items-center gap-8 mb-12"><span class="status-dot pulse" style="background:var(--success);"></span><h3 class="fw-700" style="font-size:14px;">System Log</h3></div>
          <div class="mono text-xs" style="background:#0b1220; color:#a9c4ff; border-radius:8px; padding:14px; line-height:1.85; height:210px; overflow:hidden;">
            <div><span style="color:#69c0ff;">[--:--.--]</span> Waiting for reconstruction to start...</div>
          </div>
        </div>
        
      </div>
    </div>
    <div class="text-center mt-32"><a class="btn btn-primary btn-lg" data-goto="dashboard">Skip to Dashboard (Simulate Completion) →</a></div>
  </div>
</section>

<!-- ============================================================= -->
<!-- 10. DASHBOARD -->
<!-- ============================================================= -->
<section class="screen" data-screen="dashboard">
  <div class="container" style="padding-top:24px; padding-bottom:56px;">
    <div class="flex items-center justify-between wrap gap-12 mb-20">
      <div>
        <div class="crumb mb-8"><span>Sessions</span><span>›</span><span class="current" id="dash-session-id">No Session</span></div>
        <h1 style="font-size:22px;" id="dash-session-title">No Active Session</h1>
        <div class="flex items-center gap-10 mt-6 wrap"><span class="tag tag-gray"><span class="tag-dot"></span>No Data</span><span class="tag tag-gray">Create a session to begin</span></div>
      </div>
      <div class="flex gap-8">
        <a class="btn btn-sm" data-goto="ask-manzar"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>Ask MANZAR</a>
        <a class="btn btn-sm" data-goto="cross-angle">Verification Matrix</a>
        <a class="btn btn-primary btn-sm" data-goto="report">Generate Report</a>
      </div>
    </div>
    <div class="grid" style="grid-template-columns:2fr 1fr; align-items:start;">
      <div>
        <div class="card" style="overflow:hidden; margin-bottom:20px;">
          <div class="flex items-center justify-between" style="padding:12px 16px; border-bottom:1px solid var(--border-2);">
            <span class="text-sm fw-600">3D Reconstruction</span>
            <div class="flex gap-6">
              <button class="btn-sm" style="border-radius:6px; border:1px solid var(--primary); background:var(--primary-bg); color:var(--primary); padding:5px 10px; font-size:11px; font-weight:600;">Damage</button>
              <button class="btn-sm" style="border-radius:6px; border:1px solid var(--warning-border); background:var(--warning-bg); color:var(--gold); padding:5px 10px; font-size:11px; font-weight:600;">Skid</button>
              <button class="btn-sm" style="border-radius:6px; border:1px solid var(--border-2); background:#fff; color:var(--text-3); padding:5px 10px; font-size:11px;">Debris</button>
              <button class="btn-sm" style="border-radius:6px; border:1px solid var(--error-border); background:var(--error-bg); color:#cf1322; padding:5px 10px; font-size:11px; font-weight:600;">Impact</button>
            </div>
          </div>
          <!-- Three.js 3D Viewer (loads real point cloud from backend) -->
          <div id="reconstruction-status-msg" class="alert alert-info mb-12" style="display:none;"></div>
          <button id="btn-view-3d" class="btn btn-primary mb-12" style="display:none; align-items:center; gap:6px;"> View 3D Model</button>
          <button id="btn-upload-mesh" class="btn mb-12" style="display:inline-flex; align-items:center; gap:6px; margin-left:8px;">⬆ Upload Mesh (Kaggle)</button>
          <input type="file" id="mesh-file-input" accept=".ply,.obj,.glb" style="display:none;">
<div id="threejs-viewer" style="width:100%; height:460px; background:linear-gradient(180deg,#0b1220,#1a2332); position:relative; overflow:hidden; display:none;">
            <canvas id="viewer-canvas" style="width:100%; height:100%; display:block;"></canvas>
            <div id="viewer-loading" style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:#fff; text-align:center; font-family:var(--font-mono);">
              <div style="font-size:32px; margin-bottom:8px;">🔬</div>
              <div style="font-size:13px; opacity:.7;">3D Viewer Ready</div>
              <div style="font-size:11px; opacity:.4; margin-top:4px;">Upload photos & start reconstruction</div>
            </div>
            <div id="viewer-controls" style="position:absolute; bottom:12px; left:12px; display:flex; gap:6px;">
              <button onclick="viewerReset()" class="btn btn-sm" style="background:rgba(255,255,255,.15); border-color:rgba(255,255,255,.2); color:#fff; font-size:11px; backdrop-filter:blur(4px);">Reset View</button>
              <button onclick="viewerToggleSpin()" class="btn btn-sm" style="background:rgba(255,255,255,.15); border-color:rgba(255,255,255,.2); color:#fff; font-size:11px; backdrop-filter:blur(4px);">Auto Rotate</button>
              <button onclick="viewerTogglePoints()" class="btn btn-sm" style="background:rgba(255,255,255,.15); border-color:rgba(255,255,255,.2); color:#fff; font-size:11px; backdrop-filter:blur(4px);">Point Size ±</button>
            </div>
            <div id="viewer-info" style="position:absolute; top:12px; right:12px; background:rgba(0,0,0,.5); color:#fff; padding:6px 10px; border-radius:6px; font-family:var(--font-mono); font-size:11px; backdrop-filter:blur(4px); display:none;"></div>
          </div>
          <!-- Fallback SVG for when no reconstruction is available -->
          <svg id="viewer-fallback" viewBox="0 0 800 460" style="width:100%; height:auto; display:none; background:linear-gradient(180deg,#f4f8ff,#ffffff);">
            <polygon points="130,410 670,410 560,180 240,180" fill="#e9eff8" stroke="#dbe3ee" stroke-width="1"/>
            <line x1="400" y1="180" x2="400" y2="410" stroke="#c8d3e0" stroke-width="2" stroke-dasharray="18,12"/>
            <path d="M 260 392 Q 305 335 335 292 Q 355 264 372 240" stroke="#faad14" stroke-width="5.5" fill="none" stroke-dasharray="9,7" stroke-linecap="round" opacity=".9"/>
            <ellipse cx="378" cy="252" rx="46" ry="28" fill="#ff4d4f" opacity=".14"/><circle cx="378" cy="252" r="13" fill="none" stroke="#ff4d4f" stroke-width="2.4"/><circle cx="378" cy="252" r="4" fill="#ff4d4f"/>
            <g fill="#8c8c8c" opacity=".6"><circle cx="392" cy="268" r="2.4"/><circle cx="404" cy="260" r="1.8"/><circle cx="398" cy="280" r="2"/><circle cx="414" cy="272" r="1.6"/></g>
            <g transform="translate(250,222)"><polygon points="8,44 106,44 116,25 -2,25" fill="#dbe8ff" stroke="#1677ff" stroke-width="1"/><polygon points="-2,25 116,25 103,8 13,8" fill="#c3d9ff" stroke="#1677ff" stroke-width="1"/><ellipse cx="20" cy="46" rx="10" ry="5" fill="#22314a"/><ellipse cx="92" cy="46" rx="10" ry="5" fill="#22314a"/><path d="M 96,40 L 116,25 L 120,32 L 109,46 L 98,43 Z" fill="#ffece8" stroke="#ff4d4f" stroke-width="1.3"/></g>
            <g transform="translate(400,240)"><ellipse cx="8" cy="36" rx="8" ry="4" fill="#22314a"/><ellipse cx="50" cy="36" rx="8" ry="4" fill="#22314a"/><polygon points="6,36 52,36 48,21 10,21" fill="#efe0ff" stroke="#722ed1" stroke-width="1"/><rect x="24" y="10" width="14" height="12" rx="3" fill="#e4ccfc" stroke="#722ed1" stroke-width="0.8"/></g>
            
            <defs><pattern id="hatchDash" width="8" height="8" patternTransform="rotate(45)" patternUnits="userSpaceOnUse"><rect width="8" height="8" fill="#f8f0ff"/><line x1="0" y1="0" x2="0" y2="8" stroke="#e0c8fb" stroke-width="3"/></pattern></defs>
            <g font-family="JetBrains Mono" font-size="9" font-weight="700">
              <circle cx="160" cy="330" r="7" fill="#fff" stroke="#52c41a" stroke-width="2"/><text x="160" y="352" text-anchor="middle" fill="#389e0d">CAM01</text>
              <circle cx="660" cy="130" r="7" fill="#fff" stroke="#1677ff" stroke-width="2"/><text x="660" y="152" text-anchor="middle" fill="#0958d9">CAM02</text>
              <circle cx="160" cy="130" r="7" fill="#fff" stroke="#13c2c2" stroke-width="2"/><text x="160" y="152" text-anchor="middle" fill="#08979c">CAM03</text>
              <circle cx="640" cy="330" r="7" fill="#fff" stroke="#722ed1" stroke-width="2" stroke-dasharray="2,2"/><text x="640" y="352" text-anchor="middle" fill="#531dab">CAM04*</text>
            </g>
          </svg>
          <div class="flex items-center justify-between" style="padding:10px 16px; border-top:1px solid var(--border-2); background:var(--fill-2);"><span class="text-3 text-xs">Drag to rotate · Scroll to zoom</span></div>
        </div>
        <h3 style="font-size:15px; margin-bottom:12px;">Annotated Evidence Photos</h3>
        <div class="grid grid-3 mb-24" id="dash-evidence-grid">
          <div class="card card-dashed card-pad" style="grid-column:1/-1; text-align:center; padding:40px 20px;">
            <div style="font-size:36px; margin-bottom:8px;">📷</div>
            <div class="text-sm fw-600 mb-4">No evidence photos yet</div>
            <div class="text-3 text-xs">Photos will appear here after capture and reconstruction.</div>
          </div>
        </div>
      </div>
      <div class="flex-col gap-16">
        <div class="card card-pad-lg" id="dash-evidence-list">
          <div class="flex items-center justify-between mb-14"><h3 style="font-size:15px;">Evidence List</h3><span class="tag tag-gray">0 items</span></div>
          <div class="flex-col gap-8">
            <div class="text-center text-3 text-xs" style="padding:16px 0;">No evidence detected yet.</div>
          </div>
        </div>
        <div class="card card-pad-lg" id="dash-timeline-card">
          <div class="flex items-center justify-between mb-14"><h3 style="font-size:15px;">Investigation Timeline</h3><span class="tag tag-gray" id="dash-timeline-count">0 events</span></div>
          <div class="flex-col gap-0" id="dash-timeline-list" style="max-height:320px; overflow-y:auto;">
            <div class="text-center text-3 text-xs" style="padding:16px 0;">Timeline will build as investigation progresses.</div>
          </div>
        </div>
        <div class="card card-pad-lg" id="dash-cross-angle">
          <h3 style="font-size:15px; margin-bottom:12px;">Cross-Angle Score</h3>
          <div id="dash-cross-angle-content">
            <div class="text-center mb-14"><div class="mono fw-700 text-3" style="font-size:38px;">—</div><div class="text-3 text-xs">No data yet</div></div>
            <div class="flex-col gap-8">
              <div class="text-center text-3 text-xs" style="padding:8px 0;">Start reconstruction to see cross-angle analysis.</div>
            </div>
          </div>
          <a class="btn btn-block justify-center btn-sm mt-14" data-goto="cross-angle">Full Verification Matrix →</a>
        </div>
        <div class="card card-pad-lg" style="border-color:var(--primary-border); background:var(--primary-bg);">
          <div class="flex items-center gap-8 mb-8"><span style="font-size:16px;">💬</span><h3 style="font-size:14px; color:var(--primary-active);">Ask MANZAR</h3></div>
          <p class="text-sm mb-12" style="color:#0958d9;">Interrogate this session's evidence conversationally instead of reading the full report.</p>
          <div class="mb-10" style="background:#fff; border:1px solid var(--primary-border); border-radius:8px; padding:9px 12px; font-size:12.5px; color:var(--text-3);">Start a session to ask questions about evidence…</div>
          <a class="btn btn-primary btn-block justify-center btn-sm" data-goto="ask-manzar">Open Ask MANZAR →</a>
        </div>
        <div class="card card-pad-lg" id="dash-details-card">
          <h3 style="font-size:15px; margin-bottom:12px;">Case Details</h3>
          <div class="flex-col gap-8 text-sm" id="dash-details-list">
            <div class="flex justify-between"><span class="text-3">Case Number</span><span class="mono text-3" id="dd-case-num">—</span></div>
            <div class="flex justify-between"><span class="text-3">Location</span><span class="text-3" id="dd-location">—</span></div>
            <div class="flex justify-between"><span class="text-3">Officer</span><span class="text-3" id="dd-officer">—</span></div>
            <div class="flex justify-between"><span class="text-3">Date</span><span class="mono text-3" id="dd-date">—</span></div>
            <div class="flex justify-between"><span class="text-3">Photos</span><span class="mono text-3" id="dd-photos">0</span></div>
            <div class="flex justify-between"><span class="text-3">Cameras</span><span class="mono text-3" id="dd-cameras">0</span></div>
            <div class="flex justify-between"><span class="text-3">GPS</span><span class="mono text-3" id="dd-gps" style="font-size:10px;">—</span></div>
          </div>
        </div>
        <div class="flex-col gap-8">
          <a class="btn btn-block justify-center" data-goto="report">📄 View Full Report</a>
          <a class="btn btn-block justify-center" data-goto="session-history">🗂 Back to Sessions</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================= -->
<!-- 11. CROSS-ANGLE VERIFICATION -->
<!-- ============================================================= -->
<section class="screen" data-screen="cross-angle">
  <div class="container" style="padding-top:32px; padding-bottom:56px;">
    <div class="crumb mb-16"><a data-goto="dashboard">Dashboard</a><span>›</span><span class="current">Verification Matrix</span></div>
    <h1 style="font-size:24px; margin-bottom:6px;">Cross-Angle Consistency Verification</h1>
    <p class="text-2 mb-24">Which detections were corroborated by more than one independent camera angle.</p>
    <div class="grid grid-4 mb-28">
      <div class="card card-pad text-center"><div class="mono fw-700 text-3" style="font-size:26px;">—</div><div class="text-3 text-xs">Overall consistency</div></div>
      <div class="card card-pad text-center"><div class="mono fw-700 text-3" style="font-size:26px;">0</div><div class="text-3 text-xs">Fully confirmed</div></div>
      <div class="card card-pad text-center"><div class="mono fw-700 text-3" style="font-size:26px;">0</div><div class="text-3 text-xs">Single/partial source</div></div>
      
    </div>
    <div class="card" style="overflow-x:auto; margin-bottom:28px;">
      <table class="table">
        <thead><tr><th>Evidence Type</th><th class="center">CAM-01</th><th class="center">CAM-02</th><th class="center">CAM-03</th><th class="center">CAM-04</th><th>Status</th></tr></thead>
        <tbody>
          <tr><td colspan="6" class="text-center text-3" style="padding:24px;">No verification data yet. Run reconstruction to generate cross-angle analysis.</td></tr>
        </tbody>
      </table>
    </div>
    <div class="grid grid-2 mb-28">
      <div class="card card-pad-lg" id="cross-evidence-details"><h3 style="font-size:15px; margin-bottom:14px;">Evidence Details</h3><p class="text-3 text-sm" style="line-height:1.7;">No evidence detected yet. Upload clear photos showing vehicle damage, skid marks, debris, or impact points. Once evidence is found, this card will explain what was seen and from which angles.</p></div>
      <div class="card card-pad-lg" id="cross-single-source"><h3 style="font-size:15px; margin-bottom:14px;">Single-Source Items</h3><p class="text-3 text-sm" style="line-height:1.7;">Single-source evidence — items seen from only one angle — will appear here. You can strengthen the case by taking more photos of the same evidence from a different viewpoint.</p></div>
    </div>
    <div class="alert alert-warning"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><p><strong>Legal caution:</strong> Cross-angle corroboration indicates evidentiary consistency, not legal fault. MANZAR produces an advisory "consistent with / inconsistent with" statement only — automatic legal or fault verdicts are explicitly out of scope (SRS §5.2).</p></div>
  </div>
</section>

<!-- ============================================================= -->
<!-- 12. ASK MANZAR -->
<!-- ============================================================= -->
<section class="screen" data-screen="ask-manzar">
  <div class="container" style="padding-top:24px; padding-bottom:44px;">
    <div class="crumb mb-16"><a data-goto="dashboard">Dashboard</a><span>›</span><span class="current">Ask MANZAR</span></div>
    <div class="flex items-center justify-between wrap gap-12 mb-18">
      <div><h1 style="font-size:22px;">💬 Ask MANZAR</h1><p class="text-2 text-sm mt-4">Conversational Evidence Exploration — <span class="mono" id="ask-session-label">no active session</span></p></div>
      <span class="tag tag-gray tag-lg" id="ask-session-status">No Session Loaded</span>
    </div>
    <div class="chat-shell">
      <div class="chat-side">
        <div class="text-xs fw-700 text-3 mb-10" style="text-transform:uppercase; letter-spacing:.06em;">Ask about</div>
        <div class="flex-col gap-6 mb-24">
          <div class="chip-btn" style="justify-content:flex-start; width:100%;">🔍 Evidence</div>
          <div class="chip-btn" style="justify-content:flex-start; width:100%;">📷 Coverage</div>
          <div class="chip-btn" style="justify-content:flex-start; width:100%;">✅ Corroboration</div>
          <div class="chip-btn" style="justify-content:flex-start; width:100%;">⚠️ Uncertainty</div>
          <div class="chip-btn" style="justify-content:flex-start; width:100%;">🤖 AI Disclosure</div>
        </div>
        <div class="text-xs fw-700 text-3 mb-10" style="text-transform:uppercase; letter-spacing:.06em;">Data grounding</div>
        <div class="flow">
          <div class="flow-node" style="font-size:11px; padding:8px 10px; max-width:none;">Structured Evidence Graph</div>
          <div class="flow-arrow" style="padding:3px 0; font-size:12px;">↓</div>
          <div class="flow-node cyan" style="font-size:11px; padding:8px 10px; max-width:none;">Ask MANZAR</div>
          <div class="flow-arrow" style="padding:3px 0; font-size:12px;">↓</div>
          <div class="flow-node cyan" style="font-size:11px; padding:8px 10px; max-width:none;">Grounded Answer</div>
          <div class="flow-arrow" style="padding:3px 0; font-size:12px;">↓</div>
          <div class="flow-node cyan" style="font-size:11px; padding:8px 10px; max-width:none;">Evidence Sources</div>
        </div>
        <div class="alert alert-info mt-24" style="padding:10px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg><p class="text-xs">Every answer cites its evidence source. Click a source chip to open that item.</p></div>
      </div>
      <div class="chat-main">
        <div class="chat-log" id="ask-chat-log">
          <div class="chat-msg" style="animation:fadeUp .4s ease both;">
            <div class="chat-avatar bot">🧭</div>
            <div>
              <div class="chat-bubble">Hello! I'm MANZAR, your evidence assistant. Start or join a session, and I'll help you explore the evidence, coverage, and cross-angle verification data. Ask me anything about the investigation.</div>
            </div>
          </div>
        </div>
        <div class="flex gap-8 wrap" style="padding:0 18px 12px;">
          <button class="chip-btn">Which angles are missing?</button>
          <button class="chip-btn">What damage was detected?</button>
          <button class="chip-btn">Which evidence is single-source?</button>
        </div>
        <div class="chat-input-bar">
          <input class="input" placeholder="Ask about this session's evidence…" style="height:42px;" />
          <button class="btn btn-primary btn-circle" style="height:42px; width:42px;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></button>
        </div>
      </div>
    </div>
    <p class="text-3 text-xs text-center mt-16">Ask MANZAR answers only from this session's evidence — never general internet knowledge, never hallucinated detail.</p>
  </div>
</section>

<!-- ============================================================= -->
<!-- 13. REPORT -->
<!-- ============================================================= -->
<section class="screen" data-screen="report">
  <div class="container-narrow" style="padding-top:32px; padding-bottom:56px;">
    <div class="crumb mb-16"><a data-goto="dashboard">Dashboard</a><span>›</span><span class="current">Report</span></div>
    <div class="card card-pad-lg">
      <div class="flex items-start justify-between mb-20 wrap gap-12" style="border-bottom:1px solid var(--border-2); padding-bottom:20px;">
        <div>
          <span class="logo-word" style="font-size:20px;">MAN<span>ZAR</span></span>
          <div class="text-3 text-xs mt-4">Structured Incident Report</div>
          <div class="mono fw-700 text-sm mt-8" id="report-case-number" style="color:var(--primary);">—</div>
        </div>
        <div class="text-right">
          <div class="mono text-3 text-xs" id="report-date">—</div>
          <div class="mono text-3 text-xs mt-2" id="report-location">Unknown Location</div>
        </div>
      </div>

      <h2 style="font-size:19px; margin-bottom:10px;">Executive Summary</h2>
      <p class="text-2 text-sm mb-20" id="report-summary" style="line-height:1.75;">Loading report data...</p>

      <h2 style="font-size:19px; margin-bottom:12px;">Evidence Findings</h2>
      <div id="report-findings" class="mb-20">
        <div class="text-center text-3 text-sm" style="padding:20px 0;">Loading findings...</div>
      </div>

      <div class="grid grid-2 mb-20">
        <div class="card card-pad" style="background:var(--fill-2);">
          <div class="text-xs fw-700 text-3 mb-8">CROSS-ANGLE VERIFICATION</div>
          <div class="flex items-baseline gap-8">
            <span class="mono fw-700" id="report-cross-score" style="font-size:22px; color:var(--primary);">—</span>
            <span class="tag tag-blue" id="report-cross-reliability">—</span>
          </div>
        </div>
        <div class="card card-pad" style="background:var(--fill-2);">
          <div class="text-xs fw-700 text-3 mb-8">COVERAGE</div>
          <div class="flex items-baseline gap-8">
            <span class="mono fw-700" id="report-coverage" style="font-size:22px;">—</span>
            <span class="text-xs text-3">Missing: <span id="report-missing">—</span></span>
          </div>
        </div>
      </div>

      <h2 style="font-size:19px; margin-bottom:10px;">Forensic Analysis</h2>
      <p class="text-2 text-sm mb-20" id="report-forensic" style="line-height:1.75;">Loading forensic analysis...</p>

      <h2 style="font-size:19px; margin-bottom:10px;">Possible Cause of Accident</h2>
      <div class="text-2 text-sm mb-20" id="report-possible-cause" style="line-height:1.75; padding:16px; background:var(--fill-2); border-radius:8px; border-left:3px solid var(--primary);">Loading analysis...</div>

      <h2 style="font-size:19px; margin-bottom:12px;">Recommendations</h2>
      <div id="report-recommendations" class="mb-20">
        <div class="text-3 text-xs">Loading recommendations...</div>
      </div>

      <div class="alert alert-warning mb-20">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <p><strong>This report does not assign legal fault.</strong> Findings are advisory "consistent with / inconsistent with" statements only. Legal or fault determination remains the responsibility of the investigating officer, insurer, or court, per SRS §5.2.</p>
      </div>

      <div class="flex gap-10 mt-24 wrap" style="border-top:1px solid var(--border-2); padding-top:20px;">
        <button class="btn btn-primary">⬇ Export as PDF</button>
        <button class="btn"> Attach to FIR</button>
        <button class="btn">🔗 Share with Insurer</button>
        <a class="btn" data-goto="ask-manzar">💬 Ask MANZAR about this</a>
      </div>
    </div>
  </div>
</section>

