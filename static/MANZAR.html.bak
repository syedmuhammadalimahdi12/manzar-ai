// ─── SCREEN: QR Join ──────────────────────────────────────────────
function renderQrJoin(){
  if (!APP.sessionId || !APP.session) return;
  const s = APP.session;
  const screen = document.querySelector('[data-screen="qr-join"]');

  // Update session ID display
  const idEl = screen.querySelector('.mono.fw-700[style*="font-size:19px"]');
  if (idEl) idEl.textContent = APP.sessionId.toUpperCase();

  // Update device count and status
  const deviceCount = s.phones_joined ? s.phones_joined.length : 0;
  const countEl = screen.querySelector('.mono.fw-700[style*="font-size:30px"]');
  if (countEl) countEl.innerHTML = `${deviceCount} <span class="text-lg text-3" style="font-weight:400;">joined</span>`;

  // Update "Waiting" status indicator in Connected Devices header
  const statusEl = screen.querySelector('[data-screen="qr-join"] .flex.items-center.justify-between.mb-20 h2 + span');
  if (statusEl) {
    if (deviceCount > 0) {
      statusEl.innerHTML = `<span class="status-dot" style="background:var(--success);"></span><span style="color:var(--success);">${deviceCount} Connected</span>`;
    } else {
      statusEl.innerHTML = `<span class="status-dot" style="background:var(--text-4);"></span><span style="color:var(--text-3);">Waiting</span>`;
    }
  }

  // Load real QR code image from backend
  const qrImg = document.getElementById('qr-code-img');
  const qrPlaceholder = document.getElementById('qr-placeholder');
  if (qrImg && APP.sessionId) {
    qrImg.src = `${API_BASE}/session/${APP.sessionId}/qr`;
    qrImg.style.display = 'block';
    if (qrPlaceholder) qrPlaceholder.style.display = 'none';
    qrImg.onerror = () => {
      qrImg.style.display = 'none';
      if (qrPlaceholder) qrPlaceholder.style.display = 'flex';
    };
  }

  // Update connected devices list
  renderDeviceList(screen, s);

  // Update live photo list and angle coverage
  renderQrPhotoList(s);

  // Start polling for new devices
  startPolling();
}

function renderQrPhotoList(session){
  const photos = session.photos || [];
  const relevantPhotos = photos.filter(p => !p.is_irrelevant);

  // Track previous state to avoid unnecessary re-renders (prevents photo "popping")
  const photoKey = relevantPhotos.map(p => p.filename || p.url || '').join(',');
  const angleKey = (session.covered_angles || []).join(',');
  const stateKey = photoKey + '|' + angleKey;
  if (window._qrLastState === stateKey) return; // No change, skip re-render
  window._qrLastState = stateKey;

  // Update photo count
  const countEl = document.getElementById('qr-photo-count');
  if (countEl) countEl.textContent = `${relevantPhotos.length} photo${relevantPhotos.length === 1 ? '' : 's'}`;

  // Update photo list
  const listEl = document.getElementById('qr-photo-list');
  if (listEl){
    if (relevantPhotos.length === 0){
      listEl.innerHTML = '<div class="text-center text-3 text-sm" style="padding:20px 0;">No photos captured yet. Waiting for devices to upload...</div>';
    } else {
      let html = '';
      relevantPhotos.forEach((p, i) => {
        const angle = (p.angle_hint || p.detected_angle || 'unknown').toUpperCase();
        const device = p.device_id || 'unknown';
        const detCount = (p.detections || []).length;
        const time = p.uploaded_at ? new Date(p.uploaded_at).toLocaleTimeString() : '';
        html += `
          <div class="flex items-center gap-10" style="padding:10px 12px; border-radius:8px; background:var(--fill-2); border:1px solid var(--border-2);">
            <div style="width:48px; height:48px; border-radius:8px; background:var(--primary-bg); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <div class="flex-1" style="min-width:0;">
              <div class="flex items-center gap-8">
                <span class="tag tag-blue" style="font-size:9px;">${angle}</span>
                <span class="text-xs text-3">${device}</span>
              </div>
              <div class="text-xs text-3 mt-2">${detCount} detection${detCount === 1 ? '' : 's'} ${time ? '• ' + time : ''}</div>
            </div>
          </div>`;
      });
      listEl.innerHTML = html;
    }
  }

  // Update angle coverage indicators
  const coveredAngles = session.covered_angles || [];
  const angles = ['front', 'left', 'right', 'rear'];
  angles.forEach(angle => {
    const el = document.getElementById(`qr-angle-${angle}`);
    if (el){
      const isCovered = coveredAngles.includes(angle);
      el.textContent = isCovered ? 'Captured' : 'Missing';
      el.className = `tag mt-4 ${isCovered ? 'tag-green' : 'tag-gray'}`;
      el.style.fontSize = '9px';
    }
  });
}

function renderDeviceList(screen, session){
  const container = screen.querySelector('.flex-col.gap-10');
  if (!container || !session.phones_joined) return;

  const devices = session.phones_joined;
  let html = '';
  devices.forEach((d, i) => {
    const num = String(i+1).padStart(2,'0');
    html += `
      <div class="flex items-center gap-14" style="padding:14px; border-radius:10px; background:var(--success-bg); border:1px solid var(--success-border);">
        <div class="tag tag-green" style="width:38px; height:38px; border-radius:10px; justify-content:center; font-size:16px;">&#128241;</div>
        <div class="flex-1">
          <div class="flex items-center gap-8">
            <span class="mono fw-700 text-sm">CAM-${num}</span>
            <span class="tag tag-green">Connected</span>
          </div>
          <div class="text-3 text-xs mt-4">${d.device_name || d.device_id || 'Unknown device'}</div>
        </div>
        <div class="text-right">
          <div class="mono text-xs" style="color:#08979c;">${d.angle_hint || '—'} angle</div>
          <div class="mono text-xs text-4 mt-4">${d.joined_at ? new Date(d.joined_at).toLocaleTimeString() : ''}</div>
        </div>
      </div>`;
  });

  // Add waiting slots
  for (let i = devices.length; i < Math.max(devices.length + 2, 4); i++){
    const num = String(i+1).padStart(2,'0');
    html += `
      <div class="flex items-center gap-14" style="padding:14px; border-radius:10px; background:var(--fill-2); border:1px solid var(--border-2);">
        <div class="tag tag-gray" style="width:38px; height:38px; border-radius:10px; justify-content:center; font-size:16px;">&middot;</div>
        <div class="flex-1">
          <div class="flex items-center gap-8">
            <span class="mono fw-700 text-sm text-3">CAM-${num}</span>
            <span class="tag tag-gray">Waiting</span>
          </div>
          <div class="text-3 text-xs mt-4">Waiting for participant</div>
        </div>
      </div>`;
  }
  container.innerHTML = html;
}

// ─── SCREEN: Mobile Join ──────────────────────────────────────────
function renderMobileJoin(){
  if (!APP.sessionId) return;
  const screen = document.querySelector('[data-screen="mobile-join"]');
  if (!screen) return;

  // Display session ID
  const sessionIdEl = document.getElementById('mobile-session-id');
  if (sessionIdEl) sessionIdEl.textContent = APP.sessionId.toUpperCase();

  // Auto-join the session (idempotent - backend handles duplicates)
  api(`/session/${APP.sessionId}/join`, {
    method: 'POST',
    body: JSON.stringify({ device_id: APP.deviceId, device_name: navigator.userAgent.includes('iPhone') ? 'iPhone' : 'Android Phone' }),
  }).catch(()=>{});
}

// ─── SCREEN: Coverage Check ──────────────────────────────────────
function renderCoverageCheck(){
  if (!APP.session) return;
  const s = APP.session;
  const screen = document.querySelector('[data-screen="coverage-check"]');

  const covered = s.coverage_status === 'sufficient' ? s.covered_angles || ['front','left','right','rear'] : (s.covered_angles || []);
  const missing = s.missing_angles || [];
  const totalCovered = covered.length;

  // Update angle coverage header
  const headerTag = screen.querySelector('.tag.tag-amber') || screen.querySelector('.tag.tag-green');
  if (headerTag){
    headerTag.className = totalCovered >= 4 ? 'tag tag-green' : 'tag tag-amber';
    headerTag.textContent = `${totalCovered} of 4 angles captured`;
  }

  // Update angle status list
  const angleList = screen.querySelector('.flex-col.gap-8');
  if (angleList){
    const angles = ['front', 'left', 'right', 'rear'];
    let html = '';
    angles.forEach(angle => {
      const isCovered = covered.includes(angle);
      html += `
        <div class="flex items-center justify-between" style="padding:10px 12px; border-radius:8px; background:${isCovered ? 'var(--success-bg)' : 'var(--warning-bg)'}; border:1px solid ${isCovered ? 'var(--success-border)' : 'var(--warning-border)'};">
          <span class="text-sm fw-600">${angle.charAt(0).toUpperCase() + angle.slice(1)}</span>
          <span class="tag ${isCovered ? 'tag-green' : 'tag-amber'}">${isCovered ? 'Captured' : 'Missing — no ' + angle + ' angle'}</span>
        </div>`;
    });
    angleList.innerHTML = html;
  }

  // Show/hide warning alert
  const warningAlert = screen.querySelector('.alert-warning');
  if (warningAlert){
    warningAlert.style.display = missing.length > 0 ? 'flex' : 'none';
    if (missing.length > 0){
      const p = warningAlert.querySelector('p');
      if (p) p.innerHTML = `<strong>Missing view detected:</strong> no ${missing.join(' or ')} angle has been captured yet.`;
    }
  }
}

// ─── SCREEN: Evidence Upload ─────────────────────────────────────
function renderEvidenceUpload(){
  if (!APP.session) return;
  const s = APP.session;
  const screen = document.querySelector('[data-screen="evidence-upload"]');

  const photos = s.photos || [];
  const relevantPhotos = photos.filter(p => !p.is_irrelevant);
  const irrelevantPhotos = photos.filter(p => p.is_irrelevant);
  const deviceCount = s.phones_joined ? s.phones_joined.length : 0;
  const coverage = s.coverage_status === 'sufficient' ? '100%' : `${(s.covered_angles || []).length}/4`;
  const requiredPhotos = 2;
  const remainingPhotos = Math.max(0, requiredPhotos - relevantPhotos.length);
  const canStartReconstruction = remainingPhotos === 0;

  // Explain readiness in the page instead of using a toast notification.
  const notice = screen.querySelector('#reconstruction-notice');
  if (notice) {
    if (canStartReconstruction) {
      notice.className = 'alert alert-info mb-20';
      notice.textContent = 'Ready to reconstruct. The selected images will be matched for overlap and camera position.';
    } else {
      notice.className = 'alert alert-info mb-20';
      notice.textContent = `Upload ${remainingPhotos} more relevant photo${remainingPhotos === 1 ? '' : 's'} from a different, overlapping angle before reconstruction can begin.`;
    }
  }

  const reconstructionBtn = screen.querySelector('a[data-goto="ai-processing"]');
  if (reconstructionBtn) {
    reconstructionBtn.dataset.ready = String(canStartReconstruction);
    reconstructionBtn.setAttribute('aria-disabled', String(!canStartReconstruction));
    reconstructionBtn.style.opacity = canStartReconstruction ? '' : '0.55';
    reconstructionBtn.title = canStartReconstruction
      ? 'Begin reconstruction'
      : `Upload ${remainingPhotos} more relevant photo${remainingPhotos === 1 ? '' : 's'} first`;
  }

  // Update stat cards (count only relevant photos)
  const stats = screen.querySelectorAll('.mono.fw-700[style*="font-size:22px"]');
  if (stats[0]) stats[0].textContent = deviceCount;
  if (stats[1]) stats[1].textContent = relevantPhotos.length;
  if (stats[2]) stats[2].textContent = coverage;

  // Render photo grid (show all photos, badge irrelevant ones)
  const photoGrid = screen.querySelector('#eu-evidence-grid');
  const euPhotoKey = photos.map(p => p.filename || p.url || '').join(',');
  if (photoGrid && photos.length > 0 && window._euLastPhotoKey !== euPhotoKey){
    window._euLastPhotoKey = euPhotoKey;
    let html = '';
    photos.forEach((p, i) => {
      const angleLabel = p.angle_hint || 'untagged';
      const isIrrelevant = p.is_irrelevant;
      const cardStyle = isIrrelevant
        ? 'opacity:0.55; border:2px dashed #faad14;'
        : '';
      const statusBadge = isIrrelevant
        ? '<span class="tag" style="background:#fff7e6; border:1px solid #faad14; color:#ad6800; font-size:9px;">&#9888; Irrelevant</span>'
        : '<span class="tag tag-green" style="font-size:9px;">&#10003; Uploaded</span>';
      const detectionBadge = isIrrelevant
        ? '<span class="tag" style="position:absolute; top:8px; right:8px; font-size:9px; background:#fff2f0; border:1px solid #ffccc7; color:#cf1322;">0 evidence</span>'
        : '';
      html += `
        <div class="card card-hover fade-item" style="overflow:hidden; animation-delay:${i * .05}s; ${cardStyle}">
          <div style="aspect-ratio:16/10; background:linear-gradient(135deg,${isIrrelevant ? '#fff7e6,#ffe7ba' : '#dbe8ff,#fff'}); position:relative; display:flex; align-items:center; justify-content:center;">
            ${(p.path || p.url) ? `<img src="${p.path ? API_BASE + '/' + p.path : API_BASE + p.url}" style="width:100%; height:100%; object-fit:contain; background:#111;${isIrrelevant ? ' filter:grayscale(0.4);' : ''}" />` : '<span style="font-size:22px; opacity:.5;">&#128247;</span>'}
            <span class="tag tag-blue" style="position:absolute; top:8px; left:8px; font-size:9px;">${angleLabel}</span>
            ${detectionBadge}
          </div>
          <div style="padding:10px 12px;">
            <div class="flex items-center justify-between">
              <span class="mono text-xs fw-700">${p.device_id || 'CAM'}</span>
              ${statusBadge}
            </div>
            ${isIrrelevant ? '<div class="text-xs mt-4" style="color:#ad6800;">' + (p.relevance_reason || 'Not accident related') + '</div>' : '<div class="mono text-4 text-xs mt-4">' + (p.timestamp ? new Date(p.timestamp).toLocaleTimeString() : '') + '</div>'}
          </div>
        </div>`;
    });
    photoGrid.innerHTML = html;
  }
}

// ─── Photo Upload Handler ─────────────────────────────────────────
(function initUploadHandlers(){
  // File input for evidence upload screen
  const uploadBtn = document.querySelector('[data-screen="evidence-upload"] .btn-primary');
  if (uploadBtn){
    // Replace "Begin Reconstruction" to also handle upload
  }

  // Mobile camera capture button
  const mobileCapture = document.querySelector('[data-screen="mobile-camera"] a[data-goto="evidence-upload"]');
  if (mobileCapture){
    mobileCapture.addEventListener('click', async function(e){
      e.preventDefault();
      e.stopPropagation();
      // Create a file input
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.capture = 'environment';
      input.onchange = async () => {
        if (!input.files.length || !APP.sessionId) return;
        await uploadPhoto(input.files[0], 'back');
        goto('evidence-upload');
      };
      input.click();
    });
  }

  // Angle selector buttons
  const angleBtns = document.querySelectorAll('.angle-btn');
  let selectedAngle = 'auto';
  angleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      angleBtns.forEach(b => {
        b.classList.remove('selected');
        b.style.borderColor = 'var(--border)';
        b.style.background = 'var(--fill-2)';
        b.style.color = 'var(--text)';
      });
      btn.classList.add('selected');
      btn.style.borderColor = 'var(--primary)';
      btn.style.background = 'var(--primary-bg)';
      btn.style.color = 'var(--primary)';
      selectedAngle = btn.dataset.angle;
    });
  });

  // Mobile upload button
  const mobileUpload = document.getElementById('mobile-upload-btn');
  const doneBtn = document.getElementById('mobile-done-btn');
  if (mobileUpload){
    mobileUpload.addEventListener('click', async () => {
      if (!APP.sessionId) {
        const status = document.getElementById('upload-status');
        if (status) status.textContent = 'No active session';
        return;
      }

      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.multiple = true;
      input.onchange = async () => {
        if (!input.files.length) return;

        const status = document.getElementById('upload-status');
        const btn = document.getElementById('mobile-upload-btn');
        if (btn) {
          btn.disabled = true;
          btn.style.opacity = '0.6';
          btn.innerHTML = '<span class="spinner spinner-white"></span> Uploading...';
        }

        let uploaded = 0;
        let failed = 0;
        for (const file of input.files){
          try {
            const angle = selectedAngle === 'auto' ? '' : selectedAngle;
            await uploadPhoto(file, angle);
            uploaded++;
          } catch (err) {
            failed++;
          }
        }

        if (btn) {
          btn.disabled = false;
          btn.style.opacity = '1';
          btn.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg> Upload More Photos';
        }

        if (status) {
          if (failed === 0) {
            status.innerHTML = `<span style="color:var(--success);">✓ ${uploaded} photo${uploaded === 1 ? '' : 's'} uploaded. You can upload more or click Done.</span>`;
          } else {
            status.innerHTML = `<span style="color:var(--error);">✗ ${uploaded} uploaded, ${failed} failed</span>`;
          }
        }

        // Show Done button after first successful upload
        if (doneBtn && uploaded > 0) {
          doneBtn.style.display = 'block';
        }
      };
      input.click();
    });
  }

  // Done button - manually navigate to thank you screen
  if (doneBtn){
    doneBtn.addEventListener('click', () => {
      goto('mobile-thanks');
    });
  }
})();

// ─── Direct Upload Screen Logic ───────────────────────────────────
(function initDirectUpload(){
  const dropzone = document.getElementById('du-dropzone');
  const fileInput = document.getElementById('du-file-input');
  const grid = document.getElementById('du-photo-grid');
  const emptyState = document.getElementById('du-empty-state');
  const countEl = document.getElementById('du-count');
  const startBtn = document.getElementById('du-start-btn');
  const autoBtn = document.getElementById('du-auto-detect-all');
  const clearBtn = document.getElementById('du-clear-all');
  const statusEl = document.getElementById('du-status');

  let selectedFiles = []; // { file, id, angle }
  let nextId = 1;

  function updateUI(){
    if (countEl) countEl.textContent = `(${selectedFiles.length})`;
    if (emptyState) emptyState.style.display = selectedFiles.length ? 'none' : 'block';
    if (clearBtn) clearBtn.style.display = selectedFiles.length ? 'inline-flex' : 'none';
    if (startBtn) startBtn.disabled = selectedFiles.length === 0;
    if (autoBtn) autoBtn.disabled = selectedFiles.length === 0;
  }

  function renderGrid(){
    if (!grid) return;
    // Remove existing items except empty state
    Array.from(grid.children).forEach(c => { if (c.id !== 'du-empty-state') c.remove(); });

    selectedFiles.forEach((item, idx) => {
      const url = URL.createObjectURL(item.file);
      const card = document.createElement('div');
      card.className = 'card';
      card.style.cssText = 'overflow:hidden; animation:fadeUp .3s ease both; animation-delay:' + (idx * .05) + 's;';
      card.innerHTML = `
        <div style="aspect-ratio:16/10; background:#111; position:relative; display:flex; align-items:center; justify-content:center;">
          <img src="${url}" style="width:100%; height:100%; object-fit:contain;" />
          <button class="du-remove-btn" data-id="${item.id}" style="position:absolute; top:6px; right:6px; width:24px; height:24px; border-radius:50%; background:rgba(0,0,0,0.6); color:#fff; border:none; cursor:pointer; font-size:14px; display:flex; align-items:center; justify-content:center;">×</button>
        </div>
        <div style="padding:10px 12px;">
          <div class="text-xs fw-600 mb-8" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escapeHtml(item.file.name)}</div>
          <select class="du-angle-select input" data-id="${item.id}" style="height:32px; font-size:12px; padding:4px 8px;">
            <option value="auto" ${item.angle === 'auto' ? 'selected' : ''}>Auto Detect</option>
            <option value="front" ${item.angle === 'front' ? 'selected' : ''}>Front</option>
            <option value="rear" ${item.angle === 'rear' ? 'selected' : ''}>Rear</option>
            <option value="left" ${item.angle === 'left' ? 'selected' : ''}>Left</option>
            <option value="right" ${item.angle === 'right' ? 'selected' : ''}>Right</option>
          </select>
          <div class="du-angle-result text-xs mt-6" data-id="${item.id}" style="color:var(--success); min-height:16px;"></div>
        </div>`;
      grid.appendChild(card);
    });

    // Bind remove buttons
    grid.querySelectorAll('.du-remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = parseInt(btn.dataset.id);
        selectedFiles = selectedFiles.filter(f => f.id !== id);
        renderGrid();
        updateUI();
      });
    });

    // Bind angle selects
    grid.querySelectorAll('.du-angle-select').forEach(sel => {
      sel.addEventListener('change', () => {
        const id = parseInt(sel.dataset.id);
        const item = selectedFiles.find(f => f.id === id);
        if (item) item.angle = sel.value;
      });
    });

    updateUI();
  }

  function addFiles(files){
    const valid = Array.from(files).filter(f => f.type.startsWith('image/'));
    valid.forEach(file => {
      selectedFiles.push({ file, id: nextId++, angle: 'auto' });
    });
    renderGrid();
    updateUI();
  }

  if (dropzone && fileInput){
    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.style.background = 'var(--primary-bg)'; });
    dropzone.addEventListener('dragleave', () => { dropzone.style.background = ''; });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.style.background = '';
      addFiles(e.dataTransfer.files);
    });
    fileInput.addEventListener('change', () => { addFiles(fileInput.files); fileInput.value = ''; });
  }

  if (clearBtn){
    clearBtn.addEventListener('click', () => {
      selectedFiles = [];
      renderGrid();
      updateUI();
      if (statusEl) statusEl.innerHTML = '';
    });
  }

  // Set all angle selects to "auto" — AI will detect during upload
  if (autoBtn){
    autoBtn.addEventListener('click', () => {
      selectedFiles.forEach(item => { item.angle = 'auto'; });
      grid.querySelectorAll('.du-angle-select').forEach(sel => { sel.value = 'auto'; });
      if (statusEl) statusEl.innerHTML = '<span style="color:var(--success);">All photos set to Auto Detect. MANZAR AI will determine angles during upload.</span>';
    });
  }

  if (startBtn){
    startBtn.addEventListener('click', async () => {
      if (!APP.sessionId) { toast('No active session', 'error'); return; }
      startBtn.disabled = true;
      if (autoBtn) autoBtn.disabled = true;
      if (statusEl) statusEl.innerHTML = '<span style="color:var(--primary);">Uploading photos and analyzing evidence...</span>';

      let uploaded = 0;
      let failed = 0;
      for (const item of selectedFiles){
        try {
          const uploadResult = await uploadPhoto(item.file, item.angle === 'auto' ? '' : item.angle);
          // If the user left this photo on "Auto Detect", update the dropdown
          // with the angle the AI actually chose, so it is visible before
          // moving to the dashboard.
          if (item.angle === 'auto' && uploadResult && uploadResult.angle_hint && uploadResult.angle_hint !== 'unknown'){
            item.angle = uploadResult.angle_hint;
            const sel = grid.querySelector(`.du-angle-select[data-id="${item.id}"]`);
            if (sel) sel.value = item.angle;
          }
          uploaded++;
        } catch(err) {
          failed++;
        }
      }

      if (failed > 0){
        if (statusEl) statusEl.innerHTML = `<span style="color:var(--error);">${uploaded} uploaded, ${failed} failed. Please retry.</span>`;
        startBtn.disabled = false;
        if (autoBtn) autoBtn.disabled = false;
        return;
      }

      if (statusEl) statusEl.innerHTML = '<span style="color:var(--success);">Upload complete. Starting investigation...</span>';

      // Start reconstruction in background
      try {
        await refreshSessionState();
        const relevantPhotos = (APP.session?.photos || []).filter(p => !p.is_irrelevant);
        if (relevantPhotos.length >= 2){
          await api(`/session/${APP.sessionId}/reconstruct`, { method: 'POST' });
          startPolling();
        }
      } catch(err){
        console.warn('Reconstruction skipped:', err.message);
      }

      goto('dashboard');
    });
  }
})();

async function uploadPhoto(file, angleHint=''){
  if (!APP.sessionId) { toast('No active session', 'error'); return; }
  const formData = new FormData();
  formData.append('file', file);
  formData.append('angle_hint', angleHint);
  formData.append('device_id', APP.deviceId);

  try {
    const url = `${API_BASE}/session/${APP.sessionId}/upload`;
    const res = await fetch(url, { method: 'POST', body: formData });
    if (!res.ok) throw new Error(`Upload failed: ${res.status}`);
    const data = await res.json();
    if (data.is_irrelevant){
      toast('This photo doesn\'t seem related to the accident — ' + (data.relevance_reason || 'flagged as irrelevant'), 'warning', 5000);
    } else {
      toast('Photo uploaded successfully', 'success', 2500);
    }
    await refreshSessionState();
    return data;
  } catch(err){
    toast('Upload failed: ' + err.message, 'error');
  }
}

// Dropzone removed - photos received from mobile devices only

// ─── SCREEN: AI Processing / Reconstruction ───────────────────────
let reconstructStartTime = null;

document.querySelector('[data-screen="evidence-upload"] a[data-goto="ai-processing"]')?.addEventListener('click', async function(e){
  e.preventDefault();
  e.stopPropagation();
  if (!APP.sessionId) return;

  // Synchronize before validating so a just-uploaded mobile image is counted.
  await refreshSessionState();
  const relevantPhotos = (APP.session?.photos || []).filter(photo => !photo.is_irrelevant);
  if (relevantPhotos.length < 2) {
    const remaining = 2 - relevantPhotos.length;
    const notice = document.querySelector('#reconstruction-notice');
    if (notice) {
      notice.textContent = `Reconstruction has not started. Upload ${remaining} more relevant photo${remaining === 1 ? '' : 's'} with visible overlap first.`;
      notice.style.borderColor = 'var(--warning, #faad14)';
    }
    return;
  }

  setBtnLoading(this, true);
  try {
    await api(`/session/${APP.sessionId}/reconstruct`, { method: 'POST' });
    reconstructStartTime = Date.now();
    startPolling(); // poll for progress and errors
    goto('dashboard');
  } catch(err){
    const notice = document.querySelector('#reconstruction-notice');
    if (notice) {
      notice.textContent = `Reconstruction could not start: ${err.message}`;
      notice.style.borderColor = 'var(--error, #ff4d4f)';
    }
  } finally {
    setBtnLoading(this, false);
  }
});

function renderAiProcessing(){
  if (!APP.session) return;
  const s = APP.session;
  const screen = document.querySelector('[data-screen="ai-processing"]');
  const recon = s.reconstruction || {};
  const status = s.status || recon.status;

  // Update elapsed timer
  if (reconstructStartTime){
    const elapsed = ((Date.now() - reconstructStartTime) / 1000).toFixed(1);
    const timerEl = screen.querySelector('.mono.text-sm.text-3');
    if (timerEl) timerEl.textContent = `Elapsed ${elapsed}s`;
  }

  const steps = screen.querySelectorAll('.step');
  const failureMessage = recon.error || 'The reconstruction could not be completed.';
  if (status === 'reconstruction_failed' || status === 'failed') {
    stopPolling();
    const firstStep = steps[0];
    if (firstStep) {
      firstStep.className = 'step active';
      const icon = firstStep.querySelector('.step-icon');
      if (icon) icon.textContent = '×';
    }
    const logEl = screen.querySelector('.mono.text-xs[style*="background:#0b1220"]');
    if (logEl) {
      const line = document.createElement('div');
      line.textContent = `Reconstruction stopped: ${failureMessage}`;
      logEl.replaceChildren(line);
    }
    const evidencePanel = screen.querySelector('.flex-col.gap-8');
    if (evidencePanel) {
      evidencePanel.textContent = `Reconstruction could not start: ${failureMessage}`;
    }
    const skipBtn = screen.querySelector('a[data-goto="dashboard"]');
    if (skipBtn) {
      skipBtn.textContent = 'Return to Evidence Capture →';
      skipBtn.dataset.goto = 'evidence-upload';
    }
    return;
  }

  // Map backend pipeline stages to the visible processing steps.
  const stageIndexes = {
    starting: 0,
    feature_extraction: 1,
    feature_matching: 2,
    sparse_reconstruction: 3,
    dense_reconstruction: 4,
    mesh_generation: 5,
    exporting: 6,
  };
  const currentStage = recon.stage || '';
  const stageIndex = (status === 'reconstruction_done' || status === 'completed')
    ? steps.length
    : (stageIndexes[currentStage] ?? -1);
  const progress = recon.percent ?? recon.progress ?? 0;
  steps.forEach((step, i) => {
    if (i < stageIndex){
      step.className = 'step done';
      const icon = step.querySelector('.step-icon');
      if (icon) icon.textContent = '✓';
    } else if (i === stageIndex){
      step.className = 'step active';
      const icon = step.querySelector('.step-icon');
      if (icon) icon.innerHTML = '<span class="pulse" style="width:8px; height:8px; border-radius:50%; background:var(--primary); display:block;"></span>';
      // Update progress bar if present
      const prog = step.querySelector('.progress-bar');
      if (prog) prog.style.width = progress + '%';
    } else {
      step.className = 'step wait';
      const icon = step.querySelector('.step-icon');
      if (icon) icon.textContent = i + 1;
    }
  });

  // If reconstruction is done, show button to dashboard
  if (status === 'reconstruction_done' || status === 'done'){
    stopPolling();
    const skipBtn = screen.querySelector('a[data-goto="dashboard"]');
    if (skipBtn) skipBtn.textContent = 'View Dashboard →';
    toast('Reconstruction complete!', 'success');
  }

  // Update evidence detected so far
  if (s.detections && s.detections.length > 0){
    const evidencePanel = screen.querySelector('.flex-col.gap-8');
    if (evidencePanel){
      let html = '';
      s.detections.forEach(d => {
        const conf = d.confidence ? Math.round(d.confidence * 100) : 0;
        const color = conf >= 90 ? 'var(--error)' : conf >= 80 ? 'var(--gold)' : 'var(--text-3)';
        html += `
          <div class="flex items-center justify-between" style="padding:10px 12px; border-radius:8px; background:var(--fill-2);">
            <span class="text-sm">${d.label || d.type || 'Detection'}</span>
            <span class="mono conf" style="color:${color};">${conf}%</span>
          </div>`;
      });
      evidencePanel.innerHTML = html;
    }
  }

  // System log
  if (recon.logs && recon.logs.length > 0){
    const logEl = screen.querySelector('.mono.text-xs[style*="background:#0b1220"]');
    if (logEl){
      logEl.innerHTML = recon.logs.map(l =>
        `<div><span style="color:#5fe0c7;">[${l.time || ''}]</span> ${l.message || l}</div>`
      ).join('');
    }
  }
}

function updateReconstructionProgress(msg){
  const screen = document.querySelector('[data-screen="ai-processing"]');
  if (!screen) return;

  const progress = msg.percent ?? msg.progress ?? 0;
  const stage = msg.stage || '';

  // Update the active step progress bar
  const activeStep = screen.querySelector('.step.active .progress-bar');
  if (activeStep) activeStep.style.width = progress + '%';

  // Update timer
  if (reconstructStartTime){
    const elapsed = ((Date.now() - reconstructStartTime) / 1000).toFixed(1);
    const timerEl = screen.querySelector('.mono.text-sm.text-3');
    if (timerEl) timerEl.textContent = `Elapsed ${elapsed}s`;
  }

  // Append to system log
  const logEl = screen.querySelector('.mono.text-xs[style*="background:#0b1220"]');
  if (logEl && msg.message){
    const time = new Date().toLocaleTimeString('en', { hour12:false, hour:'2-digit', minute:'2-digit', second:'2-digit' });
    const line = document.createElement('div');
    line.innerHTML = `<span style="color:#5fe0c7;">[${time}]</span> ${msg.message}`;
    logEl.appendChild(line);
    logEl.scrollTop = logEl.scrollHeight;
  }

  // Advance steps
  refreshSessionState();
}

// Skip-to-dashboard button (simulates completion for demo)
document.querySelector('[data-screen="ai-processing"] a[data-goto="dashboard"]')?.addEventListener('click', async function(e){
  e.preventDefault();
  e.stopPropagation();
  stopPolling();
  await refreshSessionState();
  goto('dashboard');
});

// ─── SCREEN: Dashboard ───────────────────────────────────────────
function renderDashboard(){
  if (!APP.session) return;
  const s = APP.session;
  const screen = document.querySelector('[data-screen="dashboard"]');

  // Detection color map (shared across photo grid and evidence list)
  const detColors = {
    'skid_mark': { bg: '#fff2f0', border: '#ff4d4f', text: '#cf1322', label: 'Skid Mark' },
    'vehicle_damage': { bg: '#fff7e6', border: '#fa8c16', text: '#ad4e00', label: 'Vehicle Damage' },
    'debris_field': { bg: '#f9f0ff', border: '#722ed1', text: '#531dab', label: 'Debris Field' },
    'point_of_impact': { bg: '#fff0f6', border: '#eb2f96', text: '#c41d7f', label: 'Point of Impact' },
  };

  // Update session ID and title
  const crumb = screen.querySelector('.crumb .current');
  if (crumb) crumb.textContent = APP.sessionId ? APP.sessionId.toUpperCase() : 'Session';
  const title = screen.querySelector('#dash-session-title');
  if (title) title.textContent = `Session ${APP.sessionId}`;

  // Update status tags
  const statusTags = screen.querySelectorAll('.tag');
  const coverage = s.covered_angles ? s.covered_angles.length : 0;

  // --- PHOTO GALLERY with bounding boxes ---
  const photos = s.photos || [];
  const grid = screen.querySelector('#dash-evidence-grid');
  // State tracking to prevent re-render popping
  const dashPhotoKey = photos.map(p => p.filename || p.url || '').join(',');
  if (grid && photos.length > 0 && window._dashLastPhotoKey !== dashPhotoKey) {
    window._dashLastPhotoKey = dashPhotoKey;

    let gridHtml = '';
    photos.forEach((p, idx) => {
      const imgSrc = p.path ? `${API_BASE}/${p.path}` : (p.url ? `${API_BASE}${p.url}` : '');
      const dets = p.detections || [];
      const detCount = dets.length;
      const angle = p.angle_hint || 'unknown';
      const device = p.device_id || 'unknown';
      const detTags = {};
      dets.forEach(d => { detTags[d.class] = (detTags[d.class] || 0) + 1; });
      const tagHtml = Object.entries(detTags).map(([cls, cnt]) => {
        const c = detColors[cls] || { bg: '#f5f5f5', border: '#999', text: '#333', label: cls };
        return `<span style="display:inline-block; font-size:9px; padding:2px 6px; border-radius:4px; background:${c.bg}; border:1px solid ${c.border}; color:${c.text}; font-weight:600; margin:2px;">${c.label} x${cnt}</span>`;
      }).join('');

      gridHtml += `
        <div class="card" style="overflow:hidden; border-radius:10px; border:1px solid var(--border-2); position:relative;">
          <div style="position:relative; background:#0a0a0a; min-height:180px;">
            ${imgSrc ? `<img src="${imgSrc}" data-detections="${(JSON.stringify(dets).replace(/&/g, '&amp;').replace(/"/g, '&quot;'))}"  style="width:100%; height:100%; object-fit:contain; background:#111; display:block;" />` : '<div style="display:flex; align-items:center; justify-content:center; height:180px; color:#666;">📷 No image</div>'}
          </div>
          <div style="padding:10px 12px;">
            <div class="flex items-center justify-between mb-4">
              <span style="font-size:11px; font-weight:700; color:var(--text-1); text-transform:uppercase;">${angle}</span>
              <span style="font-size:10px; color:var(--text-3);">${device}</span>
            </div>
            <div class="flex items-center justify-between">
              <div>${tagHtml || '<span style="font-size:10px; color:#999;">No detections</span>'}</div>
              <span class="mono" style="font-size:11px; font-weight:600; color:${detCount > 0 ? 'var(--primary)' : 'var(--text-3)'};">${detCount} found</span>
            </div>
          </div>
        </div>`;
    });
    grid.innerHTML = gridHtml;
    setTimeout(drawAllDashboardBBoxes, 100);
    grid.classList.add('stagger');
  } else if (grid && photos.length === 0) {
    // Clear grid when no photos
    grid.innerHTML = '';
  }

  // Evidence list (right sidebar) — aggregate detections from all photos
  const allDetections = [];
  (s.photos || []).forEach(p => {
    if (p.detections && p.detections.length) {
      p.detections.forEach(d => allDetections.push(d));
    }
  });
  // Also include session-level detections
  if (s.detections && s.detections.length) allDetections.push(...s.detections);
  // Deduplicate by label+confidence to avoid doubles
  const seenKeys = new Set();
  const uniqueDetections = allDetections.filter(d => {
    const key = (d.label || d.class || d.type || '') + '_' + Math.round((d.confidence || 0) * 100);
    if (seenKeys.has(key)) return false;
    seenKeys.add(key);
    return true;
  });
  if (uniqueDetections.length > 0){
    const evidenceCard = screen.querySelector('#dash-evidence-list');
    if (evidenceCard) {
      const tagEl = evidenceCard.querySelector('.tag');
      if (tagEl) { tagEl.textContent = `${uniqueDetections.length} items`; tagEl.className = 'tag tag-blue'; }
      const listContainer = evidenceCard.querySelector('.flex-col.gap-8');
      if (listContainer){
        let html = '';
        // Group by class
        const grouped = {};
        uniqueDetections.forEach(d => {
          const cls = d.class || d.type || 'unknown';
          if (!grouped[cls]) grouped[cls] = [];
          grouped[cls].push(d);
        });
        Object.entries(grouped).forEach(([cls, dets]) => {
          const maxConf = Math.max(...dets.map(d => d.confidence || 0));
          const conf = Math.round(maxConf * 100);
          const c = detColors && detColors[cls] ? detColors[cls] : null;
          const dotColor = c ? c.border : '#1677ff';
          html += `
            <div class="flex items-center justify-between" style="padding:9px 0; border-bottom:1px solid var(--border-2);">
              <div class="flex items-center gap-8">
                <span style="width:8px; height:8px; border-radius:50%; background:${dotColor}; display:inline-block;"></span>
                <span class="text-sm">${cls.replace('_',' ').replace(/\b\w/g, l => l.toUpperCase())}</span>
              </div>
              <div class="flex items-center gap-8">
                <span style="font-size:10px; color:var(--text-3);">x${dets.length}</span>
                <span class="mono conf" style="color:${dotColor};">${conf}%</span>
              </div>
            </div>`;
        });
        listContainer.innerHTML = html;
      }
    }
  }

  // Cross-angle score — render full details
  const caData = s.cross_angle_results;
  const caContent = screen.querySelector('#dash-cross-angle-content');
  if (caData && caContent){
    const score = caData.overall_score != null ? caData.overall_score : 0;
    const scorePercent = Math.round(score * 100);
    const summary = caData.summary || {};
    const evidence = caData.evidence || [];
    const corroborated = summary.corroborated || 0;
    const singleSource = summary.single_source || 0;
    const reliability = score >= 0.8 ? 'HIGH' : score >= 0.5 ? 'MODERATE' : 'LOW';
    const relColor = reliability === 'HIGH' ? '#52c41a' : reliability === 'MODERATE' ? '#faad14' : '#ff4d4f';
    let caHtml = `
      <div class="text-center mb-14">
        <div class="mono fw-700" style="font-size:38px; color:${relColor};">${scorePercent}<span style="font-size:18px;">%</span></div>
        <div class="text-xs" style="color:${relColor}; font-weight:600;">${reliability} RELIABILITY</div>
      </div>
      <div class="flex justify-between" style="padding:8px 12px; background:var(--fill-2); border-radius:8px; margin-bottom:8px;">
        <span class="text-xs" style="color:var(--text-2);">Corroborated (2+ angles)</span>
        <span class="mono fw-700 text-xs" style="color:#52c41a;">${corroborated}</span>
      </div>
      <div class="flex justify-between" style="padding:8px 12px; background:var(--fill-2); border-radius:8px; margin-bottom:8px;">
        <span class="text-xs" style="color:var(--text-2);">Single source</span>
        <span class="mono fw-700 text-xs" style="color:#faad14;">${singleSource}</span>
      </div>`;
    if (evidence.length > 0){
      caHtml += '<div style="margin-top:10px; border-top:1px solid var(--border-2); padding-top:10px;">';
      evidence.forEach(e => {
        const statusColor = e.status === 'corroborated' ? '#52c41a' : e.status === 'partial' ? '#faad14' : '#ff4d4f';
        const statusLabel = e.status === 'corroborated' ? 'Corroborated' : e.status === 'partial' ? 'Partial' : 'Single source';
        const confPercent = Math.round((e.max_confidence || 0) * 100);
        caHtml += `
          <div class="flex items-center justify-between" style="padding:6px 0; border-bottom:1px solid var(--border-2);">
            <div class="flex items-center gap-6">
              <span style="width:7px; height:7px; border-radius:50%; background:${statusColor}; display:inline-block;"></span>
              <span class="text-xs fw-600">${e.label || e.type || 'Unknown'}</span>
            </div>
            <div class="flex items-center gap-6">
              <span class="text-xs" style="color:var(--text-3);">${e.confirmed_by || 0}/${e.total_cameras || 0} views</span>
              <span class="mono" style="font-size:10px; color:${statusColor};">${confPercent}%</span>
            </div>
          </div>`;
      });
      caHtml += '</div>';
    }
    caContent.innerHTML = caHtml;
  }

  // --- INVESTIGATION TIMELINE ---
  const timeline = s.timeline || [];
  const timelineList = screen.querySelector('#dash-timeline-list');
  const timelineCount = screen.querySelector('#dash-timeline-count');
  if (timelineList && timeline.length > 0) {
    if (timelineCount) { timelineCount.textContent = `${timeline.length} events`; timelineCount.className = 'tag tag-blue'; }
    const icons = { start: '&#9654;', phone: '&#9742;', camera: '&#128247;', check: '&#10004;', verify: '&#9733;', report: '&#128196;' };
    const colors = { start: '#1677ff', phone: '#13c2c2', camera: '#722ed1', check: '#52c41a', verify: '#fa8c16', report: '#1a237e' };
    let tlHtml = '';
    timeline.forEach((t, i) => {
      const timeStr = (t.time || '').substring(11, 19);
      const icon = icons[t.icon] || '&#8226;';
      const color = colors[t.icon] || '#999';
      const isLast = i === timeline.length - 1;
      tlHtml += `
        <div style="display:flex; gap:10px; padding:8px 0; ${!isLast ? 'border-bottom:1px solid var(--border-2);' : ''} align-items:flex-start;">
          <div style="min-width:24px; height:24px; border-radius:50%; background:${color}15; border:1.5px solid ${color}; display:flex; align-items:center; justify-content:center; font-size:10px; color:${color}; flex-shrink:0;">${icon}</div>
          <div style="flex:1; min-width:0;">
            <div style="font-size:11px; color:var(--text-1); line-height:1.3;">${t.detail || t.event || ''}</div>
            <div style="font-size:9px; color:var(--text-3); font-family:var(--font-mono); margin-top:2px;">${timeStr}</div>
          </div>
        </div>`;
    });
    timelineList.innerHTML = tlHtml;
  }

  // --- CASE DETAILS ---
  const caseNum = s.case_number || 'N/A';
  const location = s.location || 'Unknown';
  const officer = s.officer_name || 'N/A';
  const created = s.created_at ? s.created_at.substring(0, 10) : 'N/A';
  const gpsLat = s.gps_lat || 0;
  const gpsLng = s.gps_lng || 0;
  const el = (id) => screen.querySelector('#' + id);
  if (el('dd-case-num')) el('dd-case-num').textContent = caseNum;
  if (el('dd-location')) el('dd-location').textContent = location;
  if (el('dd-officer')) el('dd-officer').textContent = officer;
  if (el('dd-date')) el('dd-date').textContent = created;
  if (el('dd-photos')) el('dd-photos').textContent = (s.photos || []).length;
  if (el('dd-cameras')) el('dd-cameras').textContent = (s.phones_joined || []).length;
  if (el('dd-gps')) el('dd-gps').textContent = gpsLat && gpsLng ? `${gpsLat.toFixed(4)}, ${gpsLng.toFixed(4)}` : 'Not set';

  // Update title with case info
  if (title && caseNum !== 'N/A') title.textContent = caseNum;
}

// ─── SCREEN: Cross-Angle Verification ────────────────────────────
function renderCrossAngle(){
  if (!APP.session || !APP.session.cross_angle_results) return;
  const results = APP.session.cross_angle_results;
  const screen = document.querySelector('[data-screen="cross-angle"]');
  const summary = results.summary || {};

  // Update summary stats (use != null to handle 0 as valid)
  const stats = screen.querySelectorAll('.mono.fw-700[style*="font-size:26px"]');
  const score = results.overall_score != null ? results.overall_score : 0;
  if (stats[0]) stats[0].textContent = Math.round(score * 100) + '%';
  if (stats[1]) stats[1].textContent = String(summary.corroborated || 0);
  if (stats[2]) stats[2].textContent = String(summary.single_source || 0);

  // Update table if we have evidence items
  if (results.evidence && results.evidence.length > 0){
    // Collect all unique camera/angle keys dynamically
    const allCamKeys = new Set();
    results.evidence.forEach(ev => {
      Object.keys(ev.cameras || {}).forEach(k => allCamKeys.add(k));
    });
    const camKeys = Array.from(allCamKeys).sort();

    // Rebuild table header with dynamic columns
    const thead = screen.querySelector('table thead');
    if (thead) {
      let headerHtml = '<tr><th>Evidence Type</th>';
      camKeys.forEach(k => {
        const label = k.length > 12 ? k.substring(0, 10) + '...' : k;
        headerHtml += `<th class="center" style="font-size:10px;">${label}</th>`;
      });
      headerHtml += '<th>Status</th></tr>';
      thead.innerHTML = headerHtml;
    }

    const tbody = screen.querySelector('table tbody');
    if (tbody){
      let html = '';
      results.evidence.forEach(ev => {
        const cams = ev.cameras || {};
        const confirmed = ev.confirmed_by || Object.values(cams).filter(v => v === true || v > 0).length;
        const totalCams = ev.total_cameras || camKeys.length;
        const statusTag = confirmed >= 2 ? 'tag-green' : confirmed >= 1 ? 'tag-amber' : 'tag-gray';
        const statusText = confirmed >= 2 ? `Confirmed · ${confirmed}/${totalCams}` : confirmed >= 1 ? 'Single-source' : 'Unconfirmed';

        html += `<tr><td class="cell-strong">${ev.label || ev.type}</td>`;
        camKeys.forEach(k => {
          const val = cams[k];
          if (val && val !== false) {
            html += '<td class="center">&#9989;</td>';
          } else {
            html += '<td class="center"><span class="text-4">—</span></td>';
          }
        });
        html += `<td><span class="tag ${statusTag}">${statusText}</span></td></tr>`;
      });
      tbody.innerHTML = html;
    }
  }

  // Populate Evidence Details card with easy, explanatory text
  const detailsCard = document.getElementById('cross-evidence-details') || screen.querySelector('.grid.grid-2 > .card:nth-child(1)');
  const singleSourceCard = document.getElementById('cross-single-source') || screen.querySelector('.grid.grid-2 > .card:nth-child(2)');

  if (results.evidence && results.evidence.length > 0){
    if (detailsCard){
      let detailsHtml = '<ul style="margin:0; padding-left:18px; line-height:1.8; font-size:13px;">';
      results.evidence.forEach(ev => {
        const label = ev.label || ev.type;
        const conf = Math.round((ev.max_confidence || 0) * 100);
        const angles = (ev.angles || []).join(', ') || 'unknown';
        const status = ev.status === 'corroborated' ? 'confirmed from multiple angles' : 'seen from only one angle';
        detailsHtml += `<li style="margin-bottom:8px;"><strong>${label}</strong>: ${status}. Found in photos taken from the <strong>${angles}</strong> view with <strong>${conf}%</strong> confidence.</li>`;
      });
      detailsHtml += '</ul>';
      detailsCard.innerHTML = `<h3 style="font-size:15px; margin-bottom:14px;">Evidence Details</h3>${detailsHtml}`;
    }

    if (singleSourceCard){
      const singleItems = results.evidence.filter(ev => ev.status !== 'corroborated');
      if (singleItems.length > 0){
        let singleHtml = '<ul style="margin:0; padding-left:18px; line-height:1.8; font-size:13px;">';
        singleItems.forEach(ev => {
          const label = ev.label || ev.type;
          const angles = (ev.angles || []).join(', ') || 'unknown';
          singleHtml += `<li style="margin-bottom:8px;"><strong>${label}</strong> was seen only from the <strong>${angles}</strong> view. This means only one camera angle captured it, so it is less strong as proof. Try taking more photos from other angles to confirm it.</li>`;
        });
        singleHtml += '</ul>';
        singleSourceCard.innerHTML = `<h3 style="font-size:15px; margin-bottom:14px;">Single-Source Items</h3>${singleHtml}`;
      } else {
        singleSourceCard.innerHTML = `<h3 style="font-size:15px; margin-bottom:14px;">Single-Source Items</h3><p class="text-3 text-sm" style="line-height:1.7;">No single-source items. Every piece of evidence was confirmed from more than one angle, which makes it more reliable.</p>`;
      }
    }
  }
}

// ─── SCREEN: Ask MANZAR (Chat) ───────────────────────────────────
function renderAskManzar(){
  if (!APP.sessionId) return;
  const screen = document.querySelector('[data-screen="ask-manzar"]');

  // Update session ID in header
  const sessionLabel = screen.querySelector('.mono');
  if (sessionLabel) sessionLabel.textContent = APP.sessionId.toUpperCase();

  // Do NOT re-render chat messages here. The session polling loop calls
  // renderCurrentScreen() every few seconds, and re-rendering the whole
  // chat log makes the messages "pop" repeatedly. Messages are appended
  // incrementally by addChatMessage() instead.
}

// Chat input handler
(function initChat(){
  document.addEventListener('keydown', async (e)=>{
    if (e.key !== 'Enter') return;
    const input = document.querySelector('[data-screen="ask-manzar"] .chat-input-bar .input');
    if (!input || document.activeElement !== input) return;

    const question = input.value.trim();
    if (!question || !APP.sessionId) return;

    input.value = '';
    addChatMessage('user', question);
    showTypingIndicator();

    try {
      const data = await api(`/session/${APP.sessionId}/chat`, {
        method: 'POST',
        body: JSON.stringify({ question }),
      });
      removeTypingIndicator();
      addChatMessage('bot', data.answer, data.sources, data.category, data.confidence);
    } catch(err){
      removeTypingIndicator();
      addChatMessage('bot', 'Sorry, I could not process your question. Please make sure the backend is running.', null, 'error');
    }
  });

  // Send button click
  document.addEventListener('click', async (e)=>{
    const sendBtn = e.target.closest('[data-screen="ask-manzar"] .chat-input-bar .btn-primary');
    if (!sendBtn) return;
    const input = document.querySelector('[data-screen="ask-manzar"] .chat-input-bar .input');
    if (!input) return;

    const question = input.value.trim();
    if (!question || !APP.sessionId) return;

    input.value = '';
    addChatMessage('user', question);
    showTypingIndicator();
    setBtnLoading(sendBtn, true);

    try {
      const data = await api(`/session/${APP.sessionId}/chat`, {
        method: 'POST',
        body: JSON.stringify({ question }),
      });
      removeTypingIndicator();
      addChatMessage('bot', data.answer, data.sources, data.category, data.confidence);
    } catch(err){
      removeTypingIndicator();
      addChatMessage('bot', 'Sorry, I could not reach the backend. Is the server running?', null, 'error');
    } finally {
      setBtnLoading(sendBtn, false);
    }
  });

  // Suggestion chip clicks
  document.addEventListener('click', (e)=>{
    const chip = e.target.closest('[data-screen="ask-manzar"] .chip-btn');
    if (!chip || chip.closest('.chat-sources')) return;
    const question = chip.textContent.trim();
    if (!question) return;
    const input = document.querySelector('[data-screen="ask-manzar"] .chat-input-bar .input');
    if (input){ input.value = question; input.focus(); }
  });

  // Category sidebar chip clicks
  document.addEventListener('click', (e)=>{
    const chip = e.target.closest('[data-screen="ask-manzar"] .chat-side .chip-btn');
    if (!chip) return;
    const category = chip.textContent.trim();
    const input = document.querySelector('[data-screen="ask-manzar"] .chat-input-bar .input');
    const prompts = {
      'Evidence': 'What evidence was detected in this session?',
      'Coverage': 'Which angles are still missing?',
      'Corroboration': 'Which evidence items were confirmed by multiple cameras?',
      'Uncertainty': 'What could not be verified?',
      'AI Disclosure': 'Was any part of this scene AI-generated?',
    };
    if (input) input.value = prompts[category] || `Tell me about ${category.toLowerCase()}`;
    input?.focus();
  });
})();

function addChatMessage(role, text, sources=[], category=null, confidence=null){
  const msg = { role, text, sources, category, confidence, time: new Date() };
  APP.chatMessages.push(msg);

  const chatLog = document.querySelector('[data-screen="ask-manzar"] .chat-log');
  if (!chatLog) return;

  // Build a single message DOM element and append it. This avoids
  // re-rendering the whole chat log, which caused the repeated "popping"
  // animation every time the session polling loop refreshed the screen.
  const msgEl = document.createElement('div');
  msgEl.className = role === 'user' ? 'chat-msg user' : 'chat-msg';
  msgEl.style.animation = 'fadeUp .3s ease both';

  if (role === 'user'){
    msgEl.innerHTML = `
      <div class="chat-avatar user">&#129489;</div>
      <div class="chat-bubble">${escapeHtml(text)}</div>`;
  } else {
    let sourcesHtml = '';
    if (sources && sources.length > 0){
      sourcesHtml = '<div class="chat-sources">' +
        sources.map(s => `<span class="chip-btn" style="cursor:default;">${typeof s === 'string' ? s : (s.label || s.id || JSON.stringify(s))}</span>`).join('') +
        '</div>';
    }
    const confTag = confidence ? `<span class="tag tag-blue" style="margin-left:8px; font-size:10px;">${Math.round(confidence * 100)}% conf</span>` : '';
    msgEl.innerHTML = `
      <div class="chat-avatar bot">&#129485;</div>
      <div>
        <div class="chat-bubble" style="line-height:1.7;">${renderMarkdown(text)}${confTag}</div>
        ${sourcesHtml}
      </div>`;
  }

  chatLog.appendChild(msgEl);

  // Scroll so the BEGINNING of the new message is visible, not the end.
  // This matches normal chat apps: when a reply arrives, you see the top
  // of the reply first, not the bottom.
  const topOffset = msgEl.offsetTop - chatLog.offsetTop;
  chatLog.scrollTop = topOffset;
}

function renderMarkdown(text){
  if (!text) return '';
  let html = escapeHtml(text);
  // Headings FIRST (### -> h3, #### -> h4, etc.)
  html = html.replace(/^######\s+(.+)$/gm, '<h6 style="font-size:12px; margin:8px 0 4px; color:var(--text-1);">$1</h6>');
  html = html.replace(/^#####\s+(.+)$/gm, '<h5 style="font-size:13px; margin:8px 0 4px; color:var(--text-1);">$1</h5>');
  html = html.replace(/^####\s+(.+)$/gm, '<h4 style="font-size:14px; margin:10px 0 6px; color:var(--text-1);">$1</h4>');
  html = html.replace(/^###\s+(.+)$/gm, '<h3 style="font-size:15px; margin:12px 0 6px; color:var(--text-1);">$1</h3>');
  html = html.replace(/^##\s+(.+)$/gm, '<h2 style="font-size:17px; margin:14px 0 8px; color:var(--text-1);">$1</h2>');
  html = html.replace(/^#\s+(.+)$/gm, '<h1 style="font-size:19px; margin:16px 0 8px; color:var(--text-1);">$1</h1>');
  // Inline code first (protect from other transforms)
  html = html.replace(/`(.+?)`/g, '<code style="background:rgba(0,0,0,.08); padding:1px 5px; border-radius:3px; font-size:0.9em;">$1</code>');
  // Bold FIRST: **text** or __text__
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/__(.+?)__/g, '<strong>$1</strong>');
  // Italic AFTER bold (so ** isn't consumed by italic):
  // Pattern 1: * *text* — handles AI output with space after first asterisk
  html = html.replace(/\*\s\*([^*\n]+?)\*/g, '<em>$1</em>');
  // Pattern 2: *text* — standard italic, but not inside HTML tags
  html = html.replace(/\*([^*<\n]+?)\*(?![^<]*>)/g, '<em>$1</em>');
  // Pattern 3: _text_ — underscore italic
  html = html.replace(/_([^_<\n]+?)_(?![^<]*>)/g, '<em>$1</em>');
  // Unordered lists: lines starting with - or *
  html = html.replace(/^[\-\*] (.+)$/gm, '<li>$1</li>');
  html = html.replace(/(<li>.*<\/li>\n?)+/g, '<ul style="margin:8px 0; padding-left:20px;">$&</ul>');
  // Ordered lists: lines starting with number.
  html = html.replace(/^\d+\. (.+)$/gm, '<li>$1</li>');
  // Line breaks
  html = html.replace(/\n/g, '<br/>');
  // Clean up extra br around lists
  html = html.replace(/<br\/>(<ul>)/g, '$1');
  html = html.replace(/(<\/ul>)<br\/>/g, '$1');
  // Make "Photo N" references clickable (with optional parenthetical info)
  html = html.replace(/Photo\s+(\d+)(\s*\([^)]*\))?/g, function(match, num, extra) {
    const label = 'Photo ' + num + (extra || '');
    return '<span class="photo-ref" data-photo-num="' + num + '" onclick="showChatImage(' + num + ')" style="background:rgba(64,150,255,0.15); color:#4096ff; padding:1px 8px; border-radius:4px; cursor:pointer; font-weight:600; border:1px solid rgba(64,150,255,0.3); display:inline-block; margin:1px 2px; transition:all 0.2s;" onmouseover="this.style.background=\'rgba(64,150,255,0.25)\'" onmouseout="this.style.background=\'rgba(64,150,255,0.15)\'">&#128247; ' + label + '</span>';
  });
  return html;
}

function renderChatMessages(){
  const chatLog = document.querySelector('[data-screen="ask-manzar"] .chat-log');
  if (!chatLog) return;

  let html = '';
  APP.chatMessages.forEach((msg, i) => {
    if (msg.role === 'user'){
      html += `
        <div class="chat-msg user" style="animation:fadeUp .3s ease both; animation-delay:${i * .02}s;">
          <div class="chat-avatar user">&#129489;</div>
          <div class="chat-bubble">${escapeHtml(msg.text)}</div>
        </div>`;
    } else {
      let sourcesHtml = '';
      if (msg.sources && msg.sources.length > 0){
        sourcesHtml = '<div class="chat-sources">';
        msg.sources.forEach(s => {
          const label = typeof s === 'string' ? s : (s.label || s.id || JSON.stringify(s));
          sourcesHtml += `<span class="chip-btn" style="cursor:default;">${label}</span>`;
        });
        sourcesHtml += '</div>';
      }
      const confTag = msg.confidence ? `<span class="tag tag-blue" style="margin-left:8px; font-size:10px;">${Math.round(msg.confidence * 100)}% conf</span>` : '';
      html += `
        <div class="chat-msg" style="animation:fadeUp .3s ease both; animation-delay:${i * .02}s;">
          <div class="chat-avatar bot">&#129485;</div>
          <div>
            <div class="chat-bubble" style="line-height:1.7;">${renderMarkdown(msg.text)}${confTag}</div>
            ${sourcesHtml}
          </div>
        </div>`;
    }
  });
  chatLog.innerHTML = html;
  chatLog.scrollTop = chatLog.scrollHeight;
}

function showTypingIndicator(){
  const chatLog = document.querySelector('[data-screen="ask-manzar"] .chat-log');
  if (!chatLog) return;
  const div = document.createElement('div');
  div.className = 'chat-msg typing-msg';
  div.id = 'typing-indicator';
  div.innerHTML = `<div class="chat-avatar bot">&#129485;</div><div class="chat-bubble"><div class="typing-indicator"><span></span><span></span><span></span></div></div>`;
  chatLog.appendChild(div);
  chatLog.scrollTop = chatLog.scrollHeight;
}

function removeTypingIndicator(){
  const el = document.getElementById('typing-indicator');
  if (el) el.remove();
}

function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function showChatImage(photoNum){
  if (!APP.session || !APP.session.photos) return;
  const idx = photoNum - 1;
  const photos = APP.session.photos;
  if (idx < 0 || idx >= photos.length) return;
  const p = photos[idx];
  const imgSrc = p.path ? (API_BASE + '/' + p.path) : (p.url ? (API_BASE + p.url) : '');
  if (!imgSrc) return;
  const modal = document.getElementById('chat-image-modal');
  const img = document.getElementById('chat-image-modal-img');
  const caption = document.getElementById('chat-image-modal-caption');
  // Clear any previous bbox overlays
  const wrapper = img.parentElement;
  wrapper.querySelectorAll('.bbox-overlay').forEach(el => el.remove());
  img.src = imgSrc;
  const angle = p.angle_hint || 'unknown';
  const device = p.device_id || 'unknown';
  const dets = p.detections || [];
  const detCount = dets.length;
  caption.innerHTML = '<strong>' + p.filename + '</strong> &nbsp;|&nbsp; ' + angle + ' angle &nbsp;|&nbsp; Device: ' + device + ' &nbsp;|&nbsp; ' + detCount + ' detection(s)';
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
  // Draw bounding boxes after image loads
  if (dets.length > 0) {
    img.onload = function() { drawBBoxes(img, dets); };
    if (img.complete && img.naturalWidth) { drawBBoxes(img, dets); }
  }
}

function closeChatImageModal(e){
  if (e && e.target !== e.currentTarget) return;
  const modal = document.getElementById('chat-image-modal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
}
// ESC key closes image modal
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') closeChatImageModal();
});

// ─── Detection Bounding Box Overlay ────────────────────────────────
function drawAllBBoxes(){
  document.querySelectorAll('[data-screen="evidence-upload"] img[data-detections]').forEach(img => {
    try {
      const dets = JSON.parse(img.dataset.detections);
      if (dets && dets.length) drawBBoxes(img, dets);
    } catch(e) {}
  });
}

function drawAllDashboardBBoxes(){
  document.querySelectorAll('[data-screen="dashboard"] img[data-detections]').forEach(img => {
    try {
      const dets = JSON.parse(img.dataset.detections);
      if (dets && dets.length) drawBBoxes(img, dets);
    } catch(e) {}
  });
}

function drawBBoxes(imgEl, detections){
  if(!detections || !detections.length) return;
  const wrapper = imgEl.parentElement;
  if(!wrapper || wrapper.querySelector('.bbox-overlay')) return;
  wrapper.style.position = 'relative';
  
  const colors = {
    'skid_mark': '#ff4d4f',
    'vehicle_damage': '#fa8c16',
    'debris_field': '#722ed1',
    'point_of_impact': '#eb2f96',
  };
  
  detections.forEach(d => {
    if(!d.bbox || d.bbox.length < 4) return;
    // Vision model returns [x_center, y_center, width, height] as fractions 0-1
    // Convert to [x1, y1, x2, y2] pixel coordinates
    const [xc, yc, w, h] = d.bbox;
    const iw = imgEl.naturalWidth || imgEl.width;
    const ih = imgEl.naturalHeight || imgEl.height;
    if(!iw || !ih) return;
    
    const x1 = (xc - w/2) * iw;
    const y1 = (yc - h/2) * ih;
    const x2 = (xc + w/2) * iw;
    const y2 = (yc + h/2) * ih;
    
    const scaleX = imgEl.clientWidth / iw;
    const scaleY = imgEl.clientHeight / ih;
    const borderColor = colors[d.class] || '#1677ff';
    
    const box = document.createElement('div');
    box.className = 'bbox-overlay';
    box.style.cssText = `position:absolute; border:2px solid ${borderColor}; 
      left:${x1 * scaleX}px; top:${y1 * scaleY}px; 
      width:${(x2-x1) * scaleX}px; height:${(y2-y1) * scaleY}px;
      pointer-events:none; border-radius:3px;`;
    wrapper.appendChild(box);
  });
}

// ─── SCREEN: Report ──────────────────────────────────────────────
function renderReport(){
  if (!APP.sessionId) return;
  const screen = document.querySelector('[data-screen="report"]');

  // Fetch report from backend
  api(`/session/${APP.sessionId}/report`).then(data => {
    if (!data || !data.report) return;
    const report = data.report;

    // Update case header
    const header = report.case_header || {};
    const caseNumEl = screen.querySelector('#report-case-number');
    if (caseNumEl) caseNumEl.textContent = header.case_number || 'N/A';
    
    const dateEl = screen.querySelector('#report-date');
    if (dateEl) dateEl.textContent = header.date_generated || '';
    
    const locationEl = screen.querySelector('#report-location');
    if (locationEl) locationEl.textContent = header.location || 'Unknown';

    // Update executive summary
    const summaryEl = screen.querySelector('#report-summary');
    if (summaryEl && report.summary) summaryEl.innerHTML = renderMarkdown(report.summary);

    // Update evidence findings
    const findingsContainer = screen.querySelector('#report-findings');
    if (findingsContainer && report.evidence_findings){
      let html = '';
      report.evidence_findings.forEach(f => {
        const conf = Math.round((f.max_confidence || 0) * 100);
        const color = conf >= 90 ? 'var(--error)' : conf >= 85 ? 'var(--primary)' : conf >= 80 ? 'var(--gold)' : 'var(--text-3)';
        const statusColor = f.status === 'VERIFIED' ? 'var(--success)' : f.status === 'PROVISIONAL' ? 'var(--warning)' : 'var(--text-3)';
        html += `
          <div class="card card-pad" style="margin-bottom:12px;">
            <div class="flex items-center justify-between mb-8">
              <div class="text-sm fw-700">${f.label}</div>
              <div class="mono" style="color:${color}; font-weight:700;">${conf}%</div>
            </div>
            <div class="flex items-center gap-8 mb-8">
              <span class="tag" style="background:${statusColor}20; color:${statusColor}; border:1px solid ${statusColor}40; font-size:10px;">${f.status}</span>
              <span class="text-3 text-xs">${f.count} detection${f.count === 1 ? '' : 's'} • ${f.detection_source || 'AI'}</span>
            </div>
            <div class="text-xs text-3">${f.corroboration}</div>
            ${f.angles && f.angles.length ? `<div class="text-xs text-3 mt-6">Angles: ${f.angles.join(', ')}</div>` : ''}
          </div>`;
      });
      findingsContainer.innerHTML = html || '<div class="text-center text-3" style="padding:24px;">No evidence findings yet</div>';
    }

    // Update cross-angle verification
    const crossAngle = report.cross_angle_verification || {};
    const crossScoreEl = screen.querySelector('#report-cross-score');
    if (crossScoreEl) crossScoreEl.textContent = Math.round((crossAngle.overall_score || 0) * 100) + '%';
    const crossRelEl = screen.querySelector('#report-cross-reliability');
    if (crossRelEl) crossRelEl.textContent = crossAngle.reliability || 'N/A';

    // Update coverage
    const coverage = report.coverage || {};
    const coverageEl = screen.querySelector('#report-coverage');
    if (coverageEl) coverageEl.textContent = coverage.coverage_pct || '0/4';
    const missingEl = screen.querySelector('#report-missing');
    if (missingEl) missingEl.textContent = (coverage.missing || []).join(', ') || 'None';

    // Update possible cause of accident
    const causeEl = screen.querySelector('#report-possible-cause');
    if (causeEl && report.possible_cause) causeEl.innerHTML = renderMarkdown(report.possible_cause);

    // Update recommendations
    const recContainer = screen.querySelector('#report-recommendations');
    if (recContainer && report.recommendations){
      let html = '';
      report.recommendations.forEach((r, i) => {
        html += `<div class="flex items-start gap-10 mb-10">
          <div style="width:24px; height:24px; border-radius:50%; background:var(--primary-bg); color:var(--primary); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; flex-shrink:0;">${i+1}</div>
          <div class="text-sm">${r}</div>
        </div>`;
      });
      recContainer.innerHTML = html || '<div class="text-3 text-xs">No recommendations</div>';
    }

    // Update forensic analysis
    const forensic = report.forensic_analysis || {};
    const forensicEl = screen.querySelector('#report-forensic');
    if (forensicEl && forensic.summary) forensicEl.innerHTML = renderMarkdown(forensic.summary);

  }).catch(err => {
    console.error('Failed to load report:', err);
    const container = screen.querySelector('#report-findings');
    if (container) container.innerHTML = '<div class="alert alert-error">Failed to load report. Please try again.</div>';
  });
}

// ─── SCREEN: Session History ─────────────────────────────────────
async function loadSessionHistory(){
    try {
      const data = await api('/sessions');
      const sessions = data.sessions || [];
      const tbody = document.querySelector('[data-screen="session-history"] table tbody');
      if (!tbody) return;
      if (!sessions.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-3" style="padding:40px 16px;">No sessions found. Create your first investigation session to get started.</td></tr>';
        return;
      }
      tbody.innerHTML = sessions.map(s => {
        const date = s.created_at ? new Date(s.created_at).toLocaleDateString() : '—';
        const statusColor = s.status === 'reconstruction_done' ? 'green' : s.status === 'reconstruction_failed' ? 'red' : 'gray';
        return `<tr>
          <td><span class="mono cell-strong">${s.id.toUpperCase()}</span></td>
          <td>${date}</td>
          <td class="mono">${s.photo_count || 0} photos</td>
          <td>${s.device_count || 0} devices</td>
          <td class="center mono">${s.coverage || '—'}</td>
          <td class="center mono">${s.consistency || '—'}</td>
          <td><span class="tag tag-${statusColor}">${s.reconstruction_status || s.status}</span></td>
          <td><a class="btn btn-sm" onclick="APP.sessionId='${s.id}'; api('/session/${s.id}').then(d=>{APP.session=d; goto('dashboard');}).catch(()=>{}); return false;">Open →</a></td>
        </tr>`;
      }).join('');
    } catch(e) { console.error('Session history load failed:', e); }
}

// ─── Export / Report buttons ─────────────────────────────────────
document.addEventListener('click', async (e)=>{
  const exportBtn = e.target.closest('[data-screen="report"] .btn-primary');
  if (exportBtn && exportBtn.textContent.includes('Export')){
    e.preventDefault();
    if (!APP.sessionId) { toast('No active session', 'error'); return; }
    setBtnLoading(exportBtn, true);
    try {
      // Try native PDF download first
      const pdfUrl = `${API_BASE}/session/${APP.sessionId}/report/pdf`;
      const pdfResp = await fetch(pdfUrl);
      if (pdfResp.ok) {
        const blob = await pdfResp.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `manzar_report_${APP.sessionId}.pdf`;
        document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(url);
        toast('PDF report downloaded', 'success');
        setBtnLoading(exportBtn, false);
        return;
      }
      // Fallback: HTML export
      const reportData = await api(`/session/${APP.sessionId}/report`);
      const r = reportData.report || {};
      // Generate printable HTML report
      const html = `<!DOCTYPE html><html><head><title>MANZAR Report — ${r.session_id || 'Session'}</title>
<style>body{font-family:system-ui;max-width:800px;margin:40px auto;padding:0 20px;color:#1a1a1a;}
h1{border-bottom:2px solid #1677ff;padding-bottom:8px;}h2{color:#1677ff;margin-top:32px;}
table{width:100%;border-collapse:collapse;margin:16px 0;}th,td{padding:8px 12px;border:1px solid #ddd;text-align:left;}
th{background:#f5f5f5;}.tag{display:inline-block;padding:2px 8px;border-radius:4px;font-size:12px;}
.tag-green{background:#f6ffed;color:#389e0d;border:1px solid #b7eb8f;}
.tag-amber{background:#fffbe6;color:#d48806;border:1px solid #ffe58f;}
.tag-red{background:#fff2f0;color:#cf1322;border:1px solid #ffa39e;}
.finding{padding:12px;margin:8px 0;background:#f9f9f9;border-radius:8px;border-left:4px solid #1677ff;}
.conf{font-weight:700;font-family:monospace;}.small{font-size:12px;color:#888;}
@media print{body{margin:0;}h1{page-break-after:avoid;}.finding{page-break-inside:avoid;}}</style></head>
<body><h1>MANZAR Incident Report</h1>
<p class="small">Session: ${r.session_id || 'N/A'} | Generated: ${r.generated_at ? new Date(r.generated_at).toLocaleString() : 'N/A'}</p>
<h2>Summary</h2><p>${r.summary || 'No summary available.'}</p>
<h2>Coverage</h2><p>Status: ${r.coverage?.status || 'unknown'} | Covered: ${r.coverage?.coverage_pct || '0/4'} angles</p>
${r.coverage?.missing?.length ? '<p>Missing: ' + r.coverage.missing.join(', ') + '</p>' : ''}
<h2>Evidence Findings</h2>
${(r.findings || []).map(f => '<div class="finding"><strong>' + f.label + '</strong> — ' + f.description + '<br/><span class="conf">' + Math.round((f.confidence||0)*100) + '%</span> confidence | ' + (f.corroboration || '') + '</div>').join('') || '<p>No evidence findings.</p>'}
<h2>Cross-Angle Verification</h2>
<p>Overall consistency: ${Math.round((r.cross_angle?.overall_score || 0) * 100)}%</p>
<h2>Reconstruction</h2><p>Status: ${r.reconstruction?.status || 'not started'} | Backend: ${r.reconstruction?.backend || 'N/A'}</p>
<h2>Recommendations</h2><ul>${(r.recommendations || []).map(r => '<li>' + r + '</li>').join('')}</ul>
<p class="small" style="margin-top:40px;border-top:1px solid #ddd;padding-top:16px;">${r.disclaimer || ''}</p>

<!-- Image Viewer Modal for Chat Photo References -->
<div id="chat-image-modal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.85); backdrop-filter:blur(8px); align-items:center; justify-content:center; flex-direction:column; cursor:pointer;" onclick="closeChatImageModal(event)">
  <div style="max-width:90vw; max-height:80vh; min-width:320px; min-height:240px; position:relative; display:flex; align-items:center; justify-content:center;" onclick="event.stopPropagation()">
    <img id="chat-image-modal-img" src="" style="width:100%; height:100%; max-width:90vw; max-height:80vh; min-width:320px; min-height:240px; object-fit:contain; border-radius:8px; box-shadow:0 20px 60px rgba(0,0,0,0.5);" />
    <div id="chat-image-modal-caption" style="color:#fff; text-align:center; padding:12px; font-size:13px; opacity:0.8;"></div>
  </div>
  <button onclick="closeChatImageModal()" style="position:absolute; top:20px; right:24px; background:rgba(255,255,255,0.15); border:none; color:#fff; width:40px; height:40px; border-radius:50%; font-size:20px; cursor:pointer; backdrop-filter:blur(4px);">✕</button>
</div>

</body></html>`;
      // Download as HTML
      const blob = new Blob([html], {type: 'text/html'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `MANZAR_Report_${APP.sessionId}.html`;
      a.click();
      URL.revokeObjectURL(url);
      toast('Report downloaded as HTML (open in browser → Print → PDF)', 'success');
    } catch(err) {
      toast('Export failed: ' + err.message, 'error');
    } finally {
      setBtnLoading(exportBtn, false);
    }
  }
});

