<section class="screen" data-screen="session-history">
  <div class="container" style="padding-top:32px; padding-bottom:56px;">
    <div class="flex items-center justify-between wrap gap-12 mb-6">
      <h1 style="font-size:24px;">Session History</h1>
      <a class="btn btn-primary btn-sm" data-goto="create-session">+ New Session</a>
    </div>
    <p class="text-2 mb-24">All accident reconstruction sessions across your department.</p>
    <div class="flex items-center gap-10 mb-20 wrap">
      <input class="input" style="max-width:280px;" placeholder="Search by location, FIR, officer…" />
      <select class="select" style="max-width:170px;"><option>All statuses</option><option>Completed</option><option>Processing</option><option>Awaiting evidence</option><option>Failed</option></select>
      <select class="select" style="max-width:170px;"><option>Last 30 days</option><option>Last 7 days</option><option>All time</option></select>
    </div>
