// ─── Mobile Menu ──────────────────────────────────────────────────
(function initMobileMenu(){
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-menu-overlay');
  const close = document.getElementById('mobile-menu-close');

  function openMenu(){ menu.classList.add('is-open'); overlay.classList.add('is-open'); document.body.style.overflow = 'hidden'; }
  function closeMenu(){ menu.classList.remove('is-open'); overlay.classList.remove('is-open'); document.body.style.overflow = ''; }

  if (toggle) toggle.addEventListener('click', (e)=>{ e.stopPropagation(); openMenu(); });
  if (close) close.addEventListener('click', closeMenu);
  if (overlay) overlay.addEventListener('click', closeMenu);

  // Close on menu item click
  document.querySelectorAll('.mobile-menu-item').forEach(item => {
    item.addEventListener('click', ()=>{ closeMenu(); });
  });
})();


// ═══════════════════════════════════════════════════════════════
// Three.js 3D Point Cloud / Mesh Viewer
// ═══════════════════════════════════════════════════════════════
let viewerScene, viewerCamera, viewerRenderer, viewerControls, viewerPoints, viewerMesh;
let viewerAutoRotate = true;
let viewerPointSize = 2.0;
let viewerAnimFrame = null;
let viewerInitialized = false;

function initViewer(){
  if(viewerInitialized) return;
  const container = document.getElementById('threejs-viewer');
  const canvas = document.getElementById('viewer-canvas');
  if(!container || !canvas || typeof THREE === 'undefined') return;

  viewerScene = new THREE.Scene();
  viewerScene.background = new THREE.Color(0x0b1220);
  viewerScene.fog = new THREE.FogExp2(0x0b1220, 0.0008);

  const w = container.clientWidth, h = container.clientHeight;
  viewerCamera = new THREE.PerspectiveCamera(55, w/h, 0.1, 10000);
  viewerCamera.position.set(0, 30, 80);

  viewerRenderer = new THREE.WebGLRenderer({canvas, antialias:true, alpha:true});
  viewerRenderer.setSize(w, h);
  viewerRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  viewerControls = new THREE.OrbitControls(viewerCamera, canvas);
  viewerControls.enableDamping = true;
  viewerControls.dampingFactor = 0.08;
  viewerControls.autoRotate = viewerAutoRotate;
  viewerControls.autoRotateSpeed = 0.8;
  viewerControls.maxDistance = 500;

  // Grid helper
  const grid = new THREE.GridHelper(200, 40, 0x1a3050, 0x0f1f30);
  viewerScene.add(grid);

  // Ambient + directional light
  viewerScene.add(new THREE.AmbientLight(0x404060, 0.6));
  const dir = new THREE.DirectionalLight(0xffffff, 0.8);
  dir.position.set(50, 80, 50);
  viewerScene.add(dir);

  // Axis helper
  const axes = new THREE.AxesHelper(20);
  viewerScene.add(axes);

  viewerInitialized = true;

  function animate(){
    viewerAnimFrame = requestAnimationFrame(animate);
    if(viewerControls) viewerControls.update();
    if(viewerRenderer && viewerScene && viewerCamera)
      viewerRenderer.render(viewerScene, viewerCamera);
  }
  animate();

  // Resize handler
  const ro = new ResizeObserver(()=>{
    const w2 = container.clientWidth, h2 = container.clientHeight;
    if(w2>0 && h2>0){
      viewerCamera.aspect = w2/h2;
      viewerCamera.updateProjectionMatrix();
      viewerRenderer.setSize(w2, h2);
    }
  });
  ro.observe(container);
}

function filterOutliers(geometry, keepRatio = 0.98){
  const pos = geometry.attributes.position.array;
  const col = geometry.attributes.color ? geometry.attributes.color.array : null;
  const n = geometry.attributes.position.count;
  if (n < 200) return geometry;

  const xs = [], ys = [], zs = [];
  for (let i = 0; i < n; i++) {
    xs.push(pos[i*3]); ys.push(pos[i*3+1]); zs.push(pos[i*3+2]);
  }
  xs.sort((a,b)=>a-b); ys.sort((a,b)=>a-b); zs.sort((a,b)=>a-b);
  const mx = xs[Math.floor(n/2)];
  const my = ys[Math.floor(n/2)];
  const mz = zs[Math.floor(n/2)];

  const dists = [];
  for (let i = 0; i < n; i++) {
    const dx = pos[i*3] - mx, dy = pos[i*3+1] - my, dz = pos[i*3+2] - mz;
    dists.push({ i, d: dx*dx + dy*dy + dz*dz });
  }
  dists.sort((a,b)=>a.d-b.d);
  const keepCount = Math.max(100, Math.floor(n * keepRatio));
  const keepSet = new Set(dists.slice(0, keepCount).map(x => x.i));

  const newPos = [], newCol = [], newNorm = [];
  const hasNorm = geometry.attributes.normal ? true : false;
  const norm = hasNorm ? geometry.attributes.normal.array : null;
  for (let i = 0; i < n; i++) {
    if (!keepSet.has(i)) continue;
    newPos.push(pos[i*3], pos[i*3+1], pos[i*3+2]);
    if (col) newCol.push(col[i*3], col[i*3+1], col[i*3+2]);
    if (hasNorm) newNorm.push(norm[i*3], norm[i*3+1], norm[i*3+2]);
  }

  const filtered = new THREE.BufferGeometry();
  filtered.setAttribute('position', new THREE.Float32BufferAttribute(newPos, 3));
  if (col) filtered.setAttribute('color', new THREE.Float32BufferAttribute(newCol, 3));
  if (hasNorm) filtered.setAttribute('normal', new THREE.Float32BufferAttribute(newNorm, 3));
  return filtered;
}

function loadPointCloud(url){
  if(!viewerInitialized) initViewer();
  const loading = document.getElementById('viewer-loading');
  const info = document.getElementById('viewer-info');

  if(loading){
    loading.innerHTML = '<div style="font-size:24px;margin-bottom:8px;">⏳</div><div style="font-size:13px;opacity:.7;">Loading 3D model...</div>';
    loading.style.display = 'block';
  }

  const loader = new THREE.PLYLoader();
  loader.load(url,
    function(geometry){
      // Remove old points
      if(viewerPoints){ viewerScene.remove(viewerPoints); }

      // Filter extreme outliers so the scene fits the viewport
      geometry = filterOutliers(geometry, 0.98);

      // Compute normals if missing
      if(!geometry.attributes.normal){
        geometry.computeVertexNormals();
      }

      // Create material
      let material;
      if(geometry.attributes.color){
        material = new THREE.PointsMaterial({
          size: viewerPointSize,
          vertexColors: true,
          sizeAttenuation: true,
        });
      } else {
        material = new THREE.PointsMaterial({
          size: viewerPointSize,
          color: 0x5dade2,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.85,
        });
      }

      viewerPoints = new THREE.Points(geometry, material);

      // Center the model
      geometry.computeBoundingBox();
      const box = geometry.boundingBox;
      const center = new THREE.Vector3();
      box.getCenter(center);
      viewerPoints.position.sub(center);

      viewerScene.add(viewerPoints);

      // Adjust camera
      const size = new THREE.Vector3();
      box.getSize(size);
      const maxDim = Math.max(size.x, size.y, size.z);
      const dist = maxDim * 1.8;
      viewerCamera.position.set(dist*0.5, dist*0.4, dist*0.7);
      viewerControls.target.set(0,0,0);
      viewerControls.update();

      if(loading) loading.style.display = 'none';
      if(info){
        const verts = geometry.attributes.position.count;
        info.textContent = `${verts.toLocaleString()} points | Drag to rotate`;
        info.style.display = 'block';
      }
    },
    function(xhr){
      if(loading){
        const pct = xhr.total ? Math.round(xhr.loaded/xhr.total*100) : '...';
        loading.innerHTML = `<div style="font-size:24px;margin-bottom:8px;">⏳</div><div style="font-size:13px;opacity:.7;">Loading: ${pct}%</div>`;
      }
    },
    function(error){
      console.warn('PLY load error:', error);
      if(loading){
        loading.innerHTML = '<div style="font-size:24px;margin-bottom:8px;">📦</div><div style="font-size:13px;opacity:.7;">No 3D data yet</div><div style="font-size:11px;opacity:.4;margin-top:4px;">Reconstruction will produce point cloud</div>';
      }
    }
  );
}

function loadMeshModel(url){
  if(!viewerInitialized) initViewer();
  const loading = document.getElementById('viewer-loading');
  const info = document.getElementById('viewer-info');
  if(loading){
    loading.innerHTML = '<div style="font-size:24px;margin-bottom:8px;">⏳</div><div style="font-size:13px;opacity:.7;">Loading 3D mesh...</div>';
    loading.style.display = 'block';
  }
  const loader = new THREE.OBJLoader();
  loader.load(url,
    function(obj){
      if(viewerMesh){ viewerScene.remove(viewerMesh); }
      viewerMesh = obj;
      // Apply material
      obj.traverse(function(child){
        if(child.isMesh){
          child.material = new THREE.MeshPhongMaterial({
            color: 0x8899aa,
            specular: 0x222222,
            shininess: 30,
            flatShading: true,
            transparent: true,
            opacity: 0.85,
            side: THREE.DoubleSide,
          });
        }
      });
      // Center
      const box = new THREE.Box3().setFromObject(obj);
      const center = box.getCenter(new THREE.Vector3());
      obj.position.sub(center);
      viewerScene.add(obj);
      // Camera
      const size = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z);
      const dist = maxDim * 1.8;
      viewerCamera.position.set(dist*0.5, dist*0.4, dist*0.7);
      viewerControls.target.set(0,0,0);
      viewerControls.update();
      if(loading) loading.style.display = 'none';
      if(info){
        let verts = 0;
        obj.traverse(c => { if(c.isMesh) verts += c.geometry.attributes.position.count; });
        info.textContent = verts.toLocaleString() + ' vertices | Drag to rotate';
        info.style.display = 'block';
      }
    },
    undefined,
    function(err){
      console.warn('OBJ load error:', err);
      // Fallback to point cloud
      loadPointCloud(`${API_BASE}/session/${APP.sessionId}/pointcloud`);
    }
  );
}

function viewerReset(){
  if(!viewerCamera || !viewerControls) return;
  viewerCamera.position.set(0, 30, 80);
  viewerControls.target.set(0,0,0);
  viewerControls.update();
}
function viewerToggleSpin(){
  if(!viewerControls) return;
  viewerAutoRotate = !viewerAutoRotate;
  viewerControls.autoRotate = viewerAutoRotate;
}
function viewerTogglePoints(){
  if(!viewerPoints) return;
  viewerPointSize = viewerPointSize >= 6 ? 1 : viewerPointSize + 1;
  viewerPoints.material.size = viewerPointSize;
}

// Load point cloud only when user clicks "View 3D" button
const _origGoto = goto;
goto = function(screen){
  _origGoto(screen);
  // Upload mesh from Kaggle handler
document.addEventListener('click', (e) => {
  const btn = e.target.closest('#btn-upload-mesh');
  if (btn) {
    if (!APP.sessionId) { toast('No active session', 'error'); return; }
    document.getElementById('mesh-file-input').click();
  }
});
document.getElementById('mesh-file-input').addEventListener('change', async (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const fd = new FormData();
  const ext = file.name.split('.').pop().toLowerCase();
  if (ext === 'ply') fd.append('pointcloud', file);
  else fd.append('mesh', file);
  toast('Uploading mesh file...', 'info');
  try {
    const resp = await fetch(`${API_BASE}/session/${APP.sessionId}/mesh-upload`, { method: 'POST', body: fd });
    if (!resp.ok) throw new Error('Upload failed');
    const data = await resp.json();
    toast('Mesh installed successfully!', 'success');
    // Auto-load the 3D viewer
    initViewer();
    // Try loading mesh first, then point cloud
    if (ext === 'obj' || ext === 'glb') {
      loadMeshModel(`${API_BASE}/session/${APP.sessionId}/mesh`);
    } else {
      loadPointCloud(`${API_BASE}/session/${APP.sessionId}/pointcloud`);
    }
    // Also try loading sparse point cloud as secondary layer
    setTimeout(() => loadPointCloud(`${API_BASE}/session/${APP.sessionId}/pointcloud`), 500);
  } catch(err) {
    toast('Mesh upload failed: ' + err.message, 'error');
  }
  e.target.value = '';
});

// Don't auto-load 3D — wait for user to click "View 3D Model" button
};

// Add "View 3D Model" button handler for dashboard
document.addEventListener('click', (e) => {
  const btn = e.target.closest('#btn-view-3d');
  if (!btn || !APP.sessionId) return;
  e.preventDefault();
  btn.innerHTML = '<span class="spinner spinner-white"></span> Loading...';
  setTimeout(() => {
    initViewer();
    // Check if mesh is available, otherwise load point cloud
    const recon = APP.session?.reconstruction || {};
    if (recon.mesh_path) {
      loadMeshModel(`${API_BASE}/session/${APP.sessionId}/mesh`);
    } else {
      loadPointCloud(`${API_BASE}/session/${APP.sessionId}/pointcloud`);
    }
    btn.textContent = '3D Model Loaded ✓';
    btn.disabled = true;
  }, 200);
});

// ─── STATE HELPERS — populate screens dynamically ──────────────
// Call these from your app code after session creation, device join, etc.
// All screens start empty; these helpers inject real data into the DOM.

/**
 * Set session metadata across all screens that reference session info.
 * @param {Object} data - { id, name, location, firRef, officer, datetime, status }
 */
function setSessionData(data){
  APP.sessionId = data.id || '';
  APP.session = data;
  // QR Join
  const qrName = document.getElementById('qr-session-name');
  if(qrName) qrName.textContent = data.name || data.id || '—';
  // Mobile Join
  const mobileName = document.getElementById('mobile-session-name');
  if(mobileName) mobileName.textContent = data.name || '—';
  // Evidence Upload
  const euInfo = document.getElementById('eu-session-info');
  if(euInfo) euInfo.textContent = data.name ? `${data.name}${data.location ? ' — '+data.location : ''}` : 'No active session — create one to begin.';
  // Dashboard
  const dashId = document.getElementById('dash-session-id');
  if(dashId) dashId.textContent = data.id || 'No Session';
  const dashTitle = document.getElementById('dash-session-title');
  if(dashTitle) dashTitle.textContent = data.name ? `${data.location||''} — ${data.name}` : 'No Active Session';
  // Ask MANZAR
  const askLabel = document.getElementById('ask-session-label');
  if(askLabel) askLabel.textContent = data.id || 'no active session';
  const askStatus = document.getElementById('ask-session-status');
  if(askStatus){ askStatus.textContent = data.id ? 'Session Knowledge Base · Loaded' : 'No Session Loaded'; }
}

/**
 * Update the QR device list.
 * @param {Array} devices - [{ name, model, angle, status }]
 */
function setDevices(devices){
  const container = document.getElementById('qr-device-list');
  if(!container) return;
  if(!devices || devices.length === 0){
    container.innerHTML = '<div class="text-center text-3 text-sm" style="padding:28px 0;">No devices connected yet. Share the QR code to invite participants.</div>';
    return;
  }
  container.innerHTML = devices.map(d =>
    `<div class="flex items-center justify-between" style="padding:10px 0; border-bottom:1px solid var(--border-2);">
      <div><span class="fw-600">${d.name||'Device'}</span><span class="text-3 text-xs" style="margin-left:8px;">${d.model||''}</span></div>
      <span class="tag tag-${d.status==='connected'?'green':'gray'}">${d.status||'unknown'}</span>
    </div>`
  ).join('');
  // Update device count
  const countEl = document.getElementById('qr-device-count');
  if(countEl) countEl.textContent = `${devices.length} / ${devices.length}`;
}

/**
 * Update coverage angle status.
 * @param {Object} coverage - { front: bool, left: bool, right: bool, back: bool }
 */
function setCoverage(coverage){
  // This hooks into the existing renderCoverageCheck or can be extended
  if(APP.session) APP.session.coverage = coverage;
}

/**
 * Populate evidence grid on Evidence Upload and Dashboard screens.
 * @param {Array} items - [{ id, type, camera, timestamp, status, thumbnail }]
 */
function setEvidence(items){
  const euGrid = document.getElementById('eu-evidence-grid');
  if(euGrid){
    if(!items || items.length === 0){
      euGrid.innerHTML = '<div class="card card-pad text-center text-3" style="padding:40px;">📤 No evidence uploaded yet<br/><span class="text-xs">Upload photos to begin analysis</span></div>';
    } else {
      euGrid.innerHTML = items.map(e =>
        `<div class="card card-pad"><span class="mono text-xs">${e.id}</span> · ${e.type||'Photo'}<br/><span class="text-3 text-xs">${e.camera||'—'} · ${e.status||'queued'}</span></div>`
      ).join('');
    }
  }
  const dashGrid = document.getElementById('dash-evidence-grid');
  if(dashGrid){
    if(!items || items.length === 0){
      dashGrid.innerHTML = '<div class="text-center text-3" style="padding:30px;">📷 No evidence photos yet</div>';
    } else {
      dashGrid.innerHTML = items.map(e =>
        `<div class="card card-pad"><span class="mono text-xs">${e.id}</span> · ${e.type||'Photo'}</div>`
      ).join('');
    }
  }
}

/* legacy addChatMessage removed — using renderMarkdown version */

/**
 * Populate session history table.
 * @param {Array} sessions - [{ id, location, date, officer, coverage, consistency, status }]
 */
function setSessionHistory(sessions){
  const tbody = document.getElementById('session-history-tbody');
  if(!tbody) return;
  if(!sessions || sessions.length === 0){
    tbody.innerHTML = '<tr><td colspan="8" class="text-center text-3" style="padding:40px 16px;">No sessions found. Create your first investigation session to get started.</td></tr>';
    return;
  }
  tbody.innerHTML = sessions.map(s =>
    `<tr>
      <td><span class="mono cell-strong">${s.id}</span></td>
      <td>${s.location||'—'}</td>
      <td class="mono">${s.date||'—'}</td>
      <td>${s.officer||'—'}</td>
      <td class="center mono">${s.coverage||'—'}</td>
      <td class="center mono">${s.consistency||'—'}</td>
      <td><span class="tag tag-${s.statusColor||'gray'}">${s.status||'Unknown'}</span></td>
      <td><a class="btn btn-sm" data-goto="dashboard">Open →</a></td>
    </tr>`
  ).join('');
}


// ─── URL PARAMETER HANDLER (QR code scan auto-join) ────────
(function handleJoinParam(){
  const params = new URLSearchParams(window.location.search);
  const joinId = params.get('join');
  if (joinId) {
    APP.sessionId = joinId;
    sessionStorage.setItem('manzar_session_id', APP.sessionId);
    const joinedKey = `manzar_joined_${joinId}`;
    api(`/session/${joinId}`).then(s => {
      APP.session = s;
      const openCapture = () => {
        wsConnect(APP.sessionId);
        goto('mobile-join');
        refreshSessionState();
      };

      // A scan can reload the page; register this browser only once per session.
      if (sessionStorage.getItem(joinedKey)) {
        openCapture();
        return;
      }

      api(`/session/${joinId}/join`, {
        method: 'POST',
        body: JSON.stringify({
          device_id: APP.deviceId,
          device_name: navigator.userAgent.includes('iPhone') ? 'iPhone' : 'Android Phone'
        }),
      }).then(() => {
        sessionStorage.setItem(joinedKey, 'true');
        openCapture();
      }).catch(() => {
        openCapture();
      });
    }).catch(() => {
      sessionStorage.removeItem('manzar_session_id');
    });
    // Clean URL
    window.history.replaceState({}, '', window.location.pathname);
  }
})();

// ─── RESTORE PREVIOUS SESSION (page refresh) ─────────────────────
(function restoreSession(){
  const params = new URLSearchParams(window.location.search);
  if (params.get('join')) return; // handled above
  const saved = sessionStorage.getItem('manzar_session_id');
  if (saved) {
    APP.sessionId = saved;
    api(`/session/${saved}`).then(s => {
      APP.session = s;
      wsConnect(APP.sessionId);
      refreshSessionState();
      // Stay on landing page — user navigates manually
    }).catch(() => {
      sessionStorage.removeItem('manzar_session_id');
    });
  }
})();

</script>

<!-- Image Viewer Modal for Chat Photo References -->
<div id="chat-image-modal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.85); backdrop-filter:blur(8px); align-items:center; justify-content:center; flex-direction:column; cursor:pointer;" onclick="closeChatImageModal(event)">
  <div style="max-width:90vw; max-height:80vh; min-width:320px; min-height:240px; position:relative; display:flex; align-items:center; justify-content:center;" onclick="event.stopPropagation()">
    <img id="chat-image-modal-img" src="" style="width:100%; height:100%; max-width:90vw; max-height:80vh; min-width:320px; min-height:240px; object-fit:contain; border-radius:8px; box-shadow:0 20px 60px rgba(0,0,0,0.5);" />
    <div id="chat-image-modal-caption" style="color:#fff; text-align:center; padding:12px; font-size:13px; opacity:0.8;"></div>
  </div>
  <button onclick="closeChatImageModal()" style="position:absolute; top:20px; right:24px; background:rgba(255,255,255,0.15); border:none; color:#fff; width:40px; height:40px; border-radius:50%; font-size:20px; cursor:pointer; backdrop-filter:blur(4px);">✕</button>
</div>

</body>
</html>
