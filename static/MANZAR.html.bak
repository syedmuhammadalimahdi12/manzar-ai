<section class="screen" data-screen="evidence-detail">
  <div class="flex items-center justify-center" style="min-height:100vh; padding:32px 16px; background:rgba(11,18,32,.55);">
    <div class="card" style="max-width:900px; width:100%; max-height:90vh; overflow-y:auto;">
      <div class="flex items-center justify-between" style="padding:16px 22px; border-bottom:1px solid var(--border-2);">
        <div class="flex items-center gap-10"><span class="mono fw-700 text-3">—</span><span class="tag tag-gray">No Evidence Selected</span></div>
        <a data-goto="dashboard" class="btn btn-circle btn-text" aria-label="Close"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></a>
      </div>
      <div class="grid" style="grid-template-columns:1.4fr 1fr; padding:22px; gap:24px;">
        <div>
          <div class="card" style="overflow:hidden;">
            <div style="aspect-ratio:4/3; background:var(--fill-2); display:flex; align-items:center; justify-content:center;">
              <div class="text-center">
                <div style="font-size:40px; margin-bottom:8px;">📷</div>
                <div class="text-3 text-sm">No evidence image available</div>
              </div>
            </div>
          </div>
          <div class="flex gap-8 mt-14"><div class="card card-pad" style="flex:1; text-align:center; padding:10px;"><div class="text-3 text-xs">Length</div><div class="mono fw-700 text-sm text-3">—</div></div><div class="card card-pad" style="flex:1; text-align:center; padding:10px;"><div class="text-3 text-xs">Direction</div><div class="mono fw-700 text-sm text-3">—</div></div><div class="card card-pad" style="flex:1; text-align:center; padding:10px;"><div class="text-3 text-xs">Confidence</div><div class="mono fw-700 text-sm text-3">—</div></div></div>
        </div>
        <div>
          <h3 style="font-size:15px; margin-bottom:12px;">Metadata</h3>
          <div class="flex-col gap-8 text-sm mb-20">
            <div class="flex justify-between"><span class="text-3">Source camera</span><span class="mono text-3">—</span></div>
            <div class="flex justify-between"><span class="text-3">Captured</span><span class="mono text-3">—</span></div>
            <div class="flex justify-between"><span class="text-3">GPS</span><span class="mono text-3">—</span></div>
            <div class="flex justify-between"><span class="text-3">Angle</span><span class="mono text-3">—</span></div>
            <div class="flex justify-between"><span class="text-3">Class</span><span class="mono text-3">—</span></div>
          </div>
          <h3 style="font-size:15px; margin-bottom:12px;">Corroborating Cameras</h3>
          <div class="flex-col gap-8 mb-20">
            <div class="text-center text-3 text-xs" style="padding:12px 0;">No corroboration data available.</div>
          </div>
          <div class="flex gap-8"><a class="btn btn-sm" data-goto="cross-angle">Verification Matrix</a><a class="btn btn-sm" data-goto="ask-manzar">💬 Ask about this</a></div>
        </div>
      </div>
    </div>
  </div>
</section>

