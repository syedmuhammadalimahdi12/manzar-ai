      <table class="table">
        <thead><tr><th>Session</th><th>Location</th><th>Date</th><th>Officer</th><th class="center">Coverage</th><th class="center">Consistency</th><th>Status</th><th></th></tr></thead>
        <tbody id="session-history-tbody">
          <tr><td colspan="8" class="text-center text-3" style="padding:40px 16px;">No sessions found. Create your first investigation session to get started.</td></tr>
        </tbody>
      </table>
